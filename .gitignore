support/sg2002/kvm_vision_test/dist
support/sg2002/kvm_vision_test/CMakeLists.txt

support/sg2002/additional/original
kvmapp/server/dl_lib

# Written by tools/release/release.sh so the card image reports the same version
# the package does. root.manifest layers kvmapp/ over the official application,
# so a file here covers the version that one carries.
kvmapp/version
kvmapp/base-version
kvmapp/kvm_system/kvm_system

# Release packages assembled by scripts/package.sh
/build/

# Scratch space for subagent-driven plan execution: ledgers, briefs, reports,
# and review packages. The git history is the record; these are working notes.
/.superpowers/

tools/opusbench/.build/
tools/opusbench/opusbench

# Build input, not source. The official application tarball is unpacked here
# by tools/abslots. It is published and checksummed by Sipeed, so it is fetched
# rather than committed.
official-kvmapp/
base/
release-out/
