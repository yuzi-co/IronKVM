# What a Sipeed NanoKVM is, for a board that does not run an IronKVM image.
#
# This is the copy the application tarball carries, and it holds device facts
# only. A board with an IronKVM image has the reader and its own description at
# /usr/share/ironkvm, and the reader prefers that file, so the only board that
# reads this one is a board on Sipeed's firmware. Such a card has the stock
# layout: p1 boot, p2 root, p3 data, and no sixth partition at all.
#
# It declares no layout for that reason. The description the build installs into
# an image keeps SLOT_A, SLOT_B, RECOVERY, DATA, KERNEL_IN_SLOT and
# SLOT_SIZE_MIB, because the build made that layout and the card is what the
# build says it is. Copied here those numbers describe a card this file has
# never seen: DATA=6 named /dev/mmcblk0p6 on a card whose highest partition is
# p3, so /data was not mounted and the stock behaviour was lost.
#
# BOOT_PART stays because partition 1 is the boot partition of both layouts.
# Nothing else here is a partition number. The scripts find the data partition
# on the card itself, from its filesystem label and its type. See the data
# device block in kvmapp/system/init.d/S01fs.
#
# Variants alpha, beta and pcie share this description and are told apart at
# first boot.
DEVICE=sipeed-nanokvm
SOC=sophgo-sg2002
ARCH=riscv64
KERNEL=vendor-prebuilt
BOOT_BACKEND=sg2002-initramfs
DISK=/dev/mmcblk0
BOOT_PART=1
DATA_FS=exfat
FLASH_METHOD=sd-card
CONSOLE=ttyS0,115200
RAM_MIB=256
ZRAM_MIB=96
SERVER_GOMEMLIMIT_MIB=64
SERVER_GOGC=150
LOADER_ALIASES="ld-musl-riscv64xthead.so.1 ld-musl-riscv64v_xthead.so.1 ld-musl-riscv64v0p7_xthead.so.1"
SUPPORT=official

# The board's unique id. The SoC publishes it as "UID: d199448e_1359c372", so
# the second field with the underscore removed is the id, and that is what
# raw-field2 means. S03usbdev already builds the USB gadget serial number from
# exactly that field, and S10uuid builds the hostname and three MAC addresses
# from the first four characters of the SHA-512 of the whole file, which is what
# `ironkvm-board uid --short` answers. Both values are therefore already in use
# on every deployed board, and neither may change.
UID_SOURCE=/sys/class/cvi-base/base_uid
UID_FORM=raw-field2

# The USB port. These are device facts, so they are the same here as in
# devices/sipeed-nanokvm/deviceinfo, which gates/check-tarball-deviceinfo.sh in
# ironkvm-dist holds them to.
#
# USB_ROLE_SWITCH=hook says the device supplies /usr/lib/ironkvm/hw.d/usb-role,
# which puts the port in the device role or the host role. The board that reads
# this copy is a board on Sipeed's firmware, and it has no such file, so
# S03usbdev falls back to the /proc/cviusb/otg_role code it has always run. The
# key states what the device offers; the file being there is what decides which
# path runs.
#
# USB_PHY_DRIVER and USB_PHY_DEVICE name the dwc2 platform device that
# restart_phy unbinds and binds again.
USB_ROLE_SWITCH=hook
USB_PHY_DRIVER=dwc2
USB_PHY_DEVICE=4340000.usb

# The hardware watchdog. These are device facts too, so they are the same here
# as in devices/sipeed-nanokvm/deviceinfo.
#
# soph_wdt is what creates /dev/watchdog, and /etc/init.d/S00kmod is what loads
# it, which is why S01hwdt is numbered S01 and not S00. A missing device is a
# module that was not loaded, so the refusal names it.
#
# 60 is asked for and 42 is what the hardware arms. The part is a Synopsys
# DesignWare watchdog: its steps are powers of two and the driver takes the
# largest step BELOW the request. Measured on the board on 2026-08-29, 20 and
# 30 both arm 21, 45 and 60 both arm 42, and asking for exactly 42 arms 21.
WATCHDOG_DEV=/dev/watchdog
WATCHDOG_MODULE=soph_wdt
WATCHDOG_TIMEOUT_S=60

# The network interfaces. These are device facts too, so they are the same here
# as in devices/sipeed-nanokvm/deviceinfo.
#
# The wired interface is eth0 on every variant. The wireless one is wlan0 where
# there is a radio: the alpha and the pcie variant carry one and the beta does
# not. One description covers all three, so the key states the name and not the
# presence. S30wifi finds no such interface on a beta and carries on.
#
# WLAN_IF has to be here for that reason. S30wifi reads an absent key as "this
# board has no radio" and configures nothing, so dropping this line would take
# the wireless off every board that reads this copy.
ETH_IF=eth0
WLAN_IF=wlan0

# How the board types for the managed host. A device fact too, so it is the
# same here as in devices/sipeed-nanokvm/deviceinfo.
#
# usb-gadget is the only output this board has, and it is therefore also the
# default. S03usbhid creates the three endpoints it names, and
# server/service/hid/hid.go opens them at /dev/hidg0, /dev/hidg1 and
# /dev/hidg2. The paths themselves live in the device's hid.d/usb-gadget file,
# which an IronKVM image installs at /usr/share/ironkvm/hid.d/. A board that
# reads this copy has no such file, and nothing reads one yet in either case:
# the server still holds the three paths itself.
HID_OUTPUTS=usb-gadget

# What the board offers beyond typing. A device fact too, so it is the same
# here as in devices/sipeed-nanokvm/deviceinfo.
#
# virtual-media and usb-audio-gadget are the mass_storage.disk0 and uac1.usb0
# functions that S03usbdev builds. atx-gpio is the power and reset lines that
# S15kvmhwd exports, and every variant has both. oled is the panel kvm_system
# drives.
#
# wifi is declared although the beta variant has no radio, for the same reason
# WLAN_IF above states the name and not the presence: one description covers
# all three variants, and the board is the authority on what is fitted.
#
# Nothing reads this key yet. It is here because a device fact the device's own
# description declares has to be in this copy as well, or a board on Sipeed's
# firmware would answer a question differently from the same board on an
# IronKVM image.
CAPABILITIES="virtual-media usb-audio-gadget atx-gpio oled wifi"
