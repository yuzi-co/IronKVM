#!/bin/sh

DAEMON="tailscaled"

# Every path is a variable so tools/service/test-tailscaled.sh can drive this
# script against a scratch tree and a stub daemon. On the device nothing sets
# them.
TAILSCALED=${TAILSCALED:-/usr/sbin/$DAEMON}
TAILSCALE=${TAILSCALE:-/usr/bin/tailscale}
PIDFILE=${PIDFILE:-/var/run/$DAEMON.pid}
STATEDIR=${STATEDIR:-/var/lib/tailscale}
SOCKETDIR=${SOCKETDIR:-/var/run/tailscale}
KVMDIR=${KVMDIR:-/etc/kvm}
MOUNTS=${MOUNTS:-/proc/mounts}
DATA=${DATA:-/data}
START_WAIT=${START_WAIT:-5}
STOP_WAIT=${STOP_WAIT:-15}

# The node's identity is tailscaled.state: its machine key and its login. It
# belongs to the board, not to a slot, in the same way as the ssh host key that
# S02identity carries. Kept under /var/lib it stayed on the slot, so a board
# that booted its other slot joined the tailnet as a new machine and needed a
# new login.
#
# With /data mounted the state file lives there. The state directory, which
# holds the daemon's logs and caches, stays on the slot: those are rewritten
# while the daemon runs and mean nothing to the other slot. A board with no
# /data keeps everything under /var/lib, as before.
#
# The first start with this layout copies a state file the slot already has,
# so a node that was logged in stays logged in.
IDENTITY_STATE_DIR=${IDENTITY_STATE_DIR:-$DATA/identity-system/tailscale}

# Set the port to listen on for incoming VPN packets.
# Remote nodes will automatically be informed about the new port number,
# but you might want to configure this in order to set external firewall
# settings.
PORT="41641"

# Extra flags you might want to pass to tailscaled.
FLAGS=""

# You need tailscaled at /usr/sbin to server, and tailscale at /usr/bin to operate
# STATIC version needed. Download page at https://pkgs.tailscale.com/stable/#static
PKG_URL_LATEST="https://pkgs.tailscale.com/stable/tailscale_latest_riscv64.tgz"
[ ! -x "$TAILSCALED" ] &&
    echo "$TAILSCALED not found, please download it from $PKG_URL_LATEST" &&
    echo "Then unpack it, copy $DAEMON to /usr/sbin and copy tailscale to /usr/bin" &&
    exit 1
VERSION=$("$TAILSCALED" --version|sed -n '1p'|xargs echo -n)

[ -x "$TAILSCALE" ] ||
    (echo "$TAILSCALE not found, your installation of tailscale may be broken" && exit 1)

# Clean up old forwarding configuration if it exists
if [ -f /etc/sysctl.d/99-tailscale.conf ]; then
    echo "Found old forwarding configuration, cleaning up..."
    rm -f /etc/sysctl.d/99-tailscale.conf
    sysctl -w net.ipv4.ip_forward=0 >/dev/null 2>&1
    sysctl -w net.ipv6.conf.all.forwarding=0 >/dev/null 2>&1
    echo "Cleanup completed. IPv4/IPv6 forwarding disabled."

    # Trigger IPv6 address renewal on all interfaces
    for iface in $(ls /sys/class/net/ | grep -v lo); do
        echo 0 > /proc/sys/net/ipv6/conf/$iface/forwarding 2>/dev/null
        sysctl -w net.ipv6.conf.$iface.accept_ra=2 >/dev/null 2>&1
    done

    echo "If you need exit node features, please configure manually."
fi

state_file() {
    if grep -q " $DATA " "$MOUNTS" 2>/dev/null && mkdir -p "$IDENTITY_STATE_DIR" 2>/dev/null; then
        if [ ! -s "$IDENTITY_STATE_DIR/tailscaled.state" ] && [ -s "$STATEDIR/tailscaled.state" ]; then
            cp "$STATEDIR/tailscaled.state" "$IDENTITY_STATE_DIR/tailscaled.state" 2>/dev/null ||
                rm -f "$IDENTITY_STATE_DIR/tailscaled.state"
        fi
        if [ -s "$IDENTITY_STATE_DIR/tailscaled.state" ] || [ ! -s "$STATEDIR/tailscaled.state" ]; then
            echo "$IDENTITY_STATE_DIR/tailscaled.state"
            return
        fi
    fi
    echo "$STATEDIR/tailscaled.state"
}

# The daemon is started and stopped by pid file, in the shell, rather than with
# start-stop-daemon. Sipeed's busybox builds that applet and Alpine's does not,
# so on an Alpine slot this script exited 127 and the web UI's switch did
# nothing. One way on both bases is the way that stays tested.
#
# A pid file is trusted only while its process is still tailscaled. A stale
# file after a power cut can name a pid that something else now holds, and a
# stop must not signal it.
running_pid() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null)
    case "$pid" in
        "" | *[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    grep -q "$DAEMON" "/proc/$pid/cmdline" 2>/dev/null || return 1
    echo "$pid"
}

# --- cgroup ---
# ironkvm-dist's S01cgroups makes an addons memory group with a soft and a hard
# limit, so that tailscaled, the largest process on the board, cannot take the
# memory the KVM needs. This script joins it before it starts the daemon, so
# the daemon inherits it however the script is run: at boot, or from the web UI
# through the server, whose own group it would otherwise inherit. Without the
# group nothing changes.
CGROUP_PROCS=${CGROUP_PROCS:-/sys/fs/cgroup/addons/cgroup.procs}
if [ -w "$CGROUP_PROCS" ]; then
    { echo $$ > "$CGROUP_PROCS"; } 2>/dev/null || true
fi
# --- end cgroup ---

# --- memlimit ---
# The Go memory limit, in MiB. /etc/kvm/GOMEMLIMIT is the owner's setting,
# and without it the limit is 512. A value that is not a whole number is
# ignored: Go refuses to start under a GOMEMLIMIT it cannot parse.
#
# In the addons group the kernel throttles the daemon at memory.high and kills
# it at memory.max, and Go frees memory only as its heap nears GOMEMLIMIT. A
# limit above memory.high therefore meets the throttle first, and the 512
# default meets the kill. So the limit is capped at seven eighths of
# memory.high, 56 for 64M, which leaves room for what Go does not count (the
# binary's pages and thread stacks). It is never more than 56 either: the
# group also holds PicoClaw, and a larger memory.high is room for it, not for
# this daemon. An owner's setting below that stays.
memlimit_mib() {
    mib=512
    if [ -f "$KVMDIR/GOMEMLIMIT" ]; then
        v=$(cat "$KVMDIR/GOMEMLIMIT" 2>/dev/null)
        case "$v" in
            ''|*[!0-9]*|0) ;;
            *) mib=$v ;;
        esac
    fi
    high=$(cat "${CGROUP_PROCS%/*}/memory.high" 2>/dev/null)
    case "$high" in
        ''|*[!0-9]*) ;;
        *)
            cap=$((high / 1048576 * 7 / 8))
            [ "$cap" -gt 56 ] && cap=56
            if [ "$cap" -gt 0 ] && [ "$cap" -lt "$mib" ]; then
                mib=$cap
            fi
            ;;
    esac
    echo "$mib"
}
# --- end memlimit ---

# --- syslog pipe ---
# A program's output, into syslog. syslog_pipe starts one logger reading a pipe
# and leaves the pipe's write end on fd 8. The caller starts the program with
# `>&8 2>&8 8>&- &` and then closes its own copy with `exec 8>&-`. $! is then
# the program, as with a plain `&`, so whatever tracks its pid still tracks it.
# A pipeline into logger would make $! the logger instead.
#
# The pipe is a fifo, opened here and unlinked at once, so nothing is left in
# /tmp. It is opened read-write first, which never blocks, so that opening the
# read end and then the write end does not block either.
#
# The program is the only writer. When it exits, however it exits, the logger
# reads end of file and exits too, so stopping or restarting the program never
# leaves a logger behind. The other way round is worse: a program whose logger
# has gone dies of SIGPIPE at its next write. So the logger ignores the signals
# a stop or a killall sends, and the OOM killer is told to pass it by; it holds
# one line of text and cannot grow. Only a SIGKILL by hand ends it early.
#
# Every line goes out at daemon.info under the tag given. Without logger or
# mkfifo this returns 1 and the caller starts the program as it always did.
# SYSLOG_LOGGER names another logger, or none when empty.
SYSLOG_LOGGER=${SYSLOG_LOGGER-$(command -v logger 2>/dev/null)}
# $1 = tag
syslog_pipe() {
    [ -n "$SYSLOG_LOGGER" ] || return 1
    fifo=${SYSLOG_FIFO_DIR:-/tmp}/.syslog-$1.$$
    rm -f "$fifo"
    mkfifo -m 600 "$fifo" 2>/dev/null || return 1
    exec 8<>"$fifo"
    exec 9<"$fifo" 8>"$fifo"
    rm -f "$fifo"
    ( trap '' HUP INT QUIT TERM PIPE; exec "$SYSLOG_LOGGER" -t "$1" -p daemon.info ) <&9 8>&- 9<&- &
    { echo -1000 > "/proc/$!/oom_score_adj"; } 2>/dev/null
    exec 9<&-
    return 0
}
# --- end syslog pipe ---

# The daemon's output goes to syslog, tagged tailscaled, and to /dev/null on a
# board without logger. At its default verbosity it says a hundred lines or so
# while it comes up and then a few a minute: peers, DERP and link changes, and
# its own rate limit folds a line that repeats. --verbose stays at 0; it only
# goes up from there.
#
# exec, so the pid the caller records is tailscaled itself and not a subshell
# waiting on it: stop signals that pid, and running_pid checks its cmdline.
run_daemon() {
    exec "$TAILSCALED" \
        --state="$state" \
        --statedir="$STATEDIR" \
        --socket="$SOCKETDIR/tailscaled.sock" \
        --port=${PORT} \
        $FLAGS
}

case "$1" in
        start)
                export GOMEMLIMIT="$(memlimit_mib)MiB"
                echo "GOMEMLIMIT set to ${GOMEMLIMIT}"

                if pid=$(running_pid); then
                    echo "$DAEMON is already running as $pid"
                    exit 0
                fi

                # Ensure directories exist
                mkdir -p "$STATEDIR" "$SOCKETDIR" "$(dirname "$PIDFILE")"
                state=$(state_file)

                printf "Starting $DAEMON[$VERSION]: "
                if syslog_pipe "$DAEMON"; then
                    run_daemon </dev/null >&8 2>&8 8>&- &
                    echo $! > "$PIDFILE"
                    exec 8>&-
                else
                    run_daemon </dev/null >/dev/null 2>&1 &
                    echo $! > "$PIDFILE"
                fi
                sleep "$START_WAIT"
                if running_pid >/dev/null; then
                    echo "OK"
                    "$TAILSCALE" set --accept-dns=false
                else
                    rm -f "$PIDFILE"
                    echo "FAIL"
                fi
                ;;
        stop)
                printf "Stopping $DAEMON: "
                if pid=$(running_pid); then
                    kill "$pid" 2>/dev/null
                    waited=0
                    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$STOP_WAIT" ]; do
                        sleep 1
                        waited=$((waited + 1))
                    done
                    if kill -0 "$pid" 2>/dev/null; then
                        echo "FAIL"
                    else
                        rm -f "$PIDFILE"
                        echo "OK"
                    fi
                else
                    rm -f "$PIDFILE"
                    echo "FAIL"
                fi
                printf "cleaning tailscaled: "
                "$TAILSCALED" --cleanup >/dev/null 2>&1
                [ $? = 0 ] && echo "OK" || echo "FAIL"
                ;;
        restart|reload)
                $0 stop
                $0 start
                ;;
        *)
                echo "Usage: $0 {start|stop|restart}"
                exit 1
esac

exit 0
