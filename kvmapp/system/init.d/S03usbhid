#!/bin/sh
# kvmhwd hid only

# usb_unbind empties the UDC and then reads it back.
#
# The write is not proof. configfs answers ENODEV when the gadget is already
# unbound, and a write that fails for any other reason leaves the controller
# name in place. The shell discards both. usb_bind is then handed a UDC that is
# already populated, its wait loop never runs, and it returns success without
# having bound anything - so an unbind that did not take was scored as a
# completed rebind.
#
# That matters most to the supervisor in server/service/hid/usb_watchdog.go.
# `restart` is the cheap rung it tries twice before escalating to stop_start,
# so two silent no-ops looked like two honest repairs that did not help.
usb_unbind() {
    udc=/sys/kernel/config/usb_gadget/g0/UDC

    echo "" > "$udc" 2>/dev/null

    if [ -n "$(cat "$udc" 2>/dev/null)" ]
    then
        echo "usb: the gadget is still bound to $(cat "$udc"), not rebinding"
        return 1
    fi

    return 0
}

# usb_bind hands the gadget to a device controller, and waits for one to exist.
#
# The single write this replaces assumed /sys/class/udc was populated by the
# time this script ran. It usually is. When dwc2 is still probing it is empty,
# the write puts nothing into UDC, and writing nothing to UDC is how a caller
# deliberately unbinds - so the gadget is built, never bound, and no error is
# reported anywhere. What an operator sees is a board with no keyboard.
#
# The retry comes from sipeed/LicheeRV-Nano-Build a3ccb527. The bound does not.
# That loop is `while true`, and this script runs from the rcS wait entry, so a
# controller that never appears would stop the boot before the network and the
# server start. Coming up unbound is recoverable from the web UI; not coming up
# is not, and the USB console that would answer instead is part of this gadget.
#
# The pause is a whole second because this image's BusyBox sleep is not built
# with fractional support, and the tests stub sleep so they do not pay it.
usb_bind() {
    tries=${USB_BIND_TRIES:-10}
    udc=/sys/kernel/config/usb_gadget/g0/UDC
    n=0

    while [ -z "$(cat "$udc" 2>/dev/null)" ]
    do
        if [ "$n" -ge "$tries" ]
        then
            echo "usb: no device controller after $tries tries, gadget left unbound"
            return 1
        fi

        [ "$n" -gt 0 ] && sleep 1
        n=$((n + 1))

        ls /sys/class/udc/ | cat > "$udc" 2>/dev/null
    done

    return 0
}

# usb_devinfo reads one key from the device description. S03usbdev carries the
# account of the two places it looks in and why.
usb_devinfo() {
    _reader=${DEVINFO:-ironkvm-deviceinfo}
    if [ "$_reader" = ironkvm-deviceinfo ] && ! command -v "$_reader" > /dev/null 2>&1
    then
        _reader=${DEVINFO_TARBALL:-/kvmapp/system/ironkvm-deviceinfo}
    fi
    "$_reader" get "$1" 2> /dev/null
}

# set_otg_role puts the port in a role, through the device's helper where there
# is one, and through /proc/cviusb/otg_role where there is not. S03usbdev
# carries the account of both paths, of USB_ROLE_SWITCH=none, and of why the
# write is read back at all.
#
# The pause is a whole second for the same reason usb_bind's above is.
set_otg_role() {
    role=$1

    if [ "$(usb_devinfo USB_ROLE_SWITCH)" = none ]
    then
        return 0
    fi

    hook=${USB_ROLE_HOOK:-/usr/lib/ironkvm/hw.d/usb-role}
    if [ -x "$hook" ]
    then
        "$hook" "$role"
        return $?
    fi

    tries=${USB_OTG_ROLE_TRIES:-3}
    n=0

    while [ "$n" -lt "$tries" ]
    do
        [ "$n" -gt 0 ] && sleep 1
        n=$((n + 1))

        echo "$role" > /proc/cviusb/otg_role 2>/dev/null

        if [ "$(cat /proc/cviusb/otg_role 2>/dev/null)" = "$role" ]
        then
            [ "$n" -gt 1 ] && echo "usb: otg role $role took on write $n"
            return 0
        fi
    done

    echo "usb: otg role stayed at '$(cat /proc/cviusb/otg_role 2>/dev/null)' after $tries writes, wanted $role"
    return 1
}

# usb_identity_read sets the IDs and strings the gadget shows the host:
# usb_vid, usb_pid, usb_manufacturer, usb_product, and usb_serial, which is
# empty unless the owner chose one.
#
# The web UI saves the owner's choice to /etc/kvm/usb-identity, one key=value
# per line (server/service/vm/usb-identity.go). /etc/kvm is on /data, so the
# choice survives an image and is the same on both slots. Without that file
# the older /boot/usb.vid and /boot/usb.pid still apply, and without those the
# board is a NanoKVM. The defaults are repeated in the server's default preset,
# and a test there holds the copies together.
#
# Every field is checked again here, because the file can be edited by hand
# and configfs takes whatever is written to it. A field that does not pass is
# left at its default and the rest of the file still applies: a typo in the
# product name must not cost the host its keyboard.
usb_identity_read() {
    usb_vid=0x3346
    usb_pid=0x1009
    usb_manufacturer='sipeed'
    usb_product='NanoKVM'
    usb_serial=

    [ -e /boot/usb.vid ] && usb_vid=$(cat /boot/usb.vid)
    [ -e /boot/usb.pid ] && usb_pid=$(cat /boot/usb.pid)

    _idfile=${USB_IDENTITY_FILE:-/etc/kvm/usb-identity}
    [ -r "$_idfile" ] || return 0

    _idv=$(usb_identity_field "$_idfile" vid)
    if usb_identity_id "$_idv"; then usb_vid=$_idv; else echo "usb: $_idfile: bad vid '$_idv'"; fi
    _idv=$(usb_identity_field "$_idfile" pid)
    if usb_identity_id "$_idv"; then usb_pid=$_idv; else echo "usb: $_idfile: bad pid '$_idv'"; fi
    _idv=$(usb_identity_field "$_idfile" manufacturer)
    if usb_identity_string "$_idv"; then usb_manufacturer=$_idv; else echo "usb: $_idfile: bad manufacturer"; fi
    _idv=$(usb_identity_field "$_idfile" product)
    if usb_identity_string "$_idv"; then usb_product=$_idv; else echo "usb: $_idfile: bad product"; fi
    # An empty serial is the board's own, and not an error.
    _idv=$(usb_identity_field "$_idfile" serial)
    if [ -z "$_idv" ]; then :
    elif usb_identity_serial "$_idv"; then usb_serial=$_idv
    else echo "usb: $_idfile: bad serial"
    fi

    return 0
}

# usb_identity_field prints the first value of one key in the identity file.
usb_identity_field() {
    sed -n "s/^$2=//p" "$1" | head -n 1
}

# usb_identity_id accepts 0x and four hex digits, and not zero.
usb_identity_id() {
    case "$1" in
        0x0000) return 1 ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) return 0 ;;
    esac
    return 1
}

# usb_identity_string accepts what a string descriptor holds: at most 126
# characters, and not none.
usb_identity_string() {
    [ -n "$1" ] && [ ${#1} -le 126 ]
}

# usb_identity_serial accepts 12 to 126 letters and digits. Mass storage asks
# for at least 12.
usb_identity_serial() {
    [ ${#1} -ge 12 ] && [ ${#1} -le 126 ] || return 1
    case "$1" in
        *[!0-9A-Za-z]*) return 1 ;;
    esac
    return 0
}

start_usb_dev(){
    # f_hid copies the descriptors into its instance when the gadget is bound
    # and refuses every write to them afterwards, so rebuilding on top of a
    # bound gadget rewrites nothing and still reports success. stop_start gets
    # here through start_usb_host, whose unbind can now fail, and the case arm
    # cannot test that without also treating a failed otg role write as fatal.
    # Refuse at the point the invariant is actually needed.
    if [ -n "$(cat /sys/kernel/config/usb_gadget/g0/UDC 2>/dev/null)" ]
    then
        echo "usb: the gadget is still bound, not rebuilding it"
        return 1
    fi

    . /etc/profile
    echo "usb mode: device"
    cd /sys/kernel/config/usb_gadget

    mkdir g0
    cd g0

    echo 0x0101 > bcdUSB
    echo 0x0623 > bcdDevice

    # Clear what S03usbdev set. A mode switch runs this against the gadget that
    # script built, and a composite class on a device that now carries HID
    # alone describes something that is not there.
    echo 0x00 > bDeviceClass
    echo 0x00 > bDeviceSubClass
    echo 0x00 > bDeviceProtocol
    usb_identity_read
    echo "$usb_vid" > idVendor
    echo "$usb_pid" > idProduct
    mkdir strings/0x409
    # HID-only mode has never set a serial number, and sets one only when the
    # owner chose it.
    [ -n "$usb_serial" ] && echo "$usb_serial" > strings/0x409/serialnumber
    # One write each. configfs keeps only the last write() to a string, and
    # BusyBox printf was measured on the board writing the value and the
    # newline separately, which left the manufacturer empty. cat writes the
    # whole here-document at once, and a value is expanded, never run.
    cat > strings/0x409/manufacturer <<USB_STRING
$usb_manufacturer
USB_STRING
    cat > strings/0x409/product <<USB_STRING
$usb_product
USB_STRING

    mkdir configs/c.1
    echo 0xA0 > configs/c.1/bmAttributes
    echo 200 > configs/c.1/MaxPower
    mkdir configs/c.1/strings/0x409
    echo "NanoKVM" >  configs/c.1/strings/0x409/configuration

    # Take out everything the other mode may have linked.
    #
    # `stop` writes an empty UDC and leaves configs/c.1 exactly as it was, so a
    # switch from normal mode arrives with the console, the disk, the network
    # and the speaker still in the configuration. Those are six endpoints of
    # the nine this controller fits, and HID needs three: left alone the gadget
    # refuses to bind and every /dev/hidg* disappears, which is the one outcome
    # this mode exists to avoid.
    #
    # The HID functions come out for a different reason. f_hid copies subclass,
    # protocol, report_length and the report descriptor into the instance when
    # the link is made, and refuses to write any of them while it exists, so
    # this script cannot install the hid-only descriptors over the normal ones
    # without unlinking first.
    #
    # Symlinks only, never a function directory: `rmdir functions/acm.GS0`
    # blocks for ever because /etc/inittab respawns a getty on /dev/ttyGS0.
    rm -f configs/c.1/hid.GS0 configs/c.1/hid.GS1 configs/c.1/hid.GS2
    rm -f configs/c.1/acm.GS0 configs/c.1/mass_storage.disk0           configs/c.1/rndis.usb0 configs/c.1/ncm.usb0 configs/c.1/ecm.usb0 configs/c.1/uac1.usb0
    rm -f os_desc/c.1
    echo 0 > os_desc/use

    # keyboard
    mkdir functions/hid.GS0
    echo 1 > functions/hid.GS0/subclass
    # Where the attribute exists only: see S03usbdev.
    if [ -e /boot/usb.wakeup ] && [ -e functions/hid.GS0/wakeup_on_write ]
    then
        echo 1 > functions/hid.GS0/wakeup_on_write
    elif [ -e /boot/usb.wakeup ]
    then
        echo "usb: /boot/usb.wakeup is set, and this kernel's f_hid has no wakeup_on_write"
    fi
    # keep_latest: see S03usbdev.
    if [ -e functions/hid.GS0/keep_latest ]
    then
        echo 1 > functions/hid.GS0/keep_latest
    fi
    echo 1 > functions/hid.GS0/protocol
    echo 8 > functions/hid.GS0/report_length
    echo -ne \\x05\\x01\\x09\\x06\\xa1\\x01\\x05\\x07\\x19\\xe0\\x29\\xe7\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\x95\\x01\\x75\\x08\\x81\\x03\\x95\\x05\\x75\\x01\\x05\\x08\\x19\\x01\\x29\\x05\\x91\\x02\\x95\\x01\\x75\\x03\\x91\\x03\\x95\\x06\\x75\\x08\\x15\\x00\\x25\\x65\\x05\\x07\\x19\\x00\\x29\\x65\\x81\\x00\\xc0 > functions/hid.GS0/report_desc
    ln -s functions/hid.GS0 configs/c.1

    # mouse
    mkdir functions/hid.GS1
    echo 1 > functions/hid.GS1/subclass
    if [ -e /boot/usb.wakeup ] && [ -e functions/hid.GS1/wakeup_on_write ]
    then
        echo 1 > functions/hid.GS1/wakeup_on_write
    fi
    if [ -e functions/hid.GS1/keep_latest ]
    then
        echo 1 > functions/hid.GS1/keep_latest
    fi
    echo 2 > functions/hid.GS1/protocol
    echo 5 > functions/hid.GS1/report_length
    echo -ne \\x5\\x1\\x9\\x2\\xa1\\x1\\x9\\x1\\xa1\\x0\\x5\\x9\\x19\\x1\\x29\\x3\\x15\\x0\\x25\\x1\\x95\\x3\\x75\\x1\\x81\\x2\\x95\\x1\\x75\\x5\\x81\\x3\\x5\\x1\\x9\\x30\\x9\\x31\\x9\\x38\\x15\\x81\\x25\\x7f\\x75\\x8\\x95\\x3\\x81\\x6\\x5\\xc\\xa\\x38\\x2\\x15\\x81\\x25\\x7f\\x75\\x8\\x95\\x1\\x81\\x6\\xc0\\xc0 > functions/hid.GS1/report_desc
    ln -s functions/hid.GS1 configs/c.1

    # absolute pointer: never boot. The boot mouse protocol has no absolute
    # coordinates, so claiming it here described a device this is not.
    mkdir functions/hid.GS2
    if [ -e /boot/usb.wakeup ] && [ -e functions/hid.GS2/wakeup_on_write ]
    then
        echo 1 > functions/hid.GS2/wakeup_on_write
    fi
    if [ -e functions/hid.GS2/keep_latest ]
    then
        echo 1 > functions/hid.GS2/keep_latest
    fi
    echo 2 > functions/hid.GS2/protocol
    echo 6 > functions/hid.GS2/report_length
    echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x03\\x15\\x00\\x25\\x01\\x95\\x03\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x05\\x81\\x01\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x35\\x00\\x45\\x00\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0 > functions/hid.GS2/report_desc
    ln -s functions/hid.GS2 configs/c.1

    usb_bind
    set_otg_role device
}

start_usb_host(){
    usb_unbind || return 1
    set_otg_role host
}

# start_usb is the start action. A mainline kernel slot binds a console gadget
# before this script runs (S00aagadget in ironkvm-dist); see start_usb in
# S03usbdev. Start takes it down and builds this mode's gadget. On the vendor
# kernel nothing binds a gadget first, and the first branch never runs.
start_usb() {
    if [ -n "$(cat /sys/kernel/config/usb_gadget/g0/UDC 2>/dev/null)" ]
    then
        echo "usb: a gadget is bound already, rebuilding it in HID-only mode"
        start_usb_host
    fi
    start_usb_dev
}

restart_usb_dev(){
    usb_unbind || return 1
    sleep 1
    usb_bind || return 1
    echo "USB Restart OK!"
}

# restart_phy takes the controller away from its driver and gives it back.
# S03usbdev carries the account of why the two keys have no default and why a
# board that declares neither gets a message and a zero status.
restart_phy() {
    driver=$(usb_devinfo USB_PHY_DRIVER)
    device=$(usb_devinfo USB_PHY_DEVICE)

    if [ -z "$driver" ] || [ -z "$device" ]
    then
        echo "usb: this board has no PHY restart"
        return 0
    fi

    echo "$device" > "/sys/bus/platform/drivers/$driver/unbind"
    sleep 1
    echo "$device" > "/sys/bus/platform/drivers/$driver/bind"
    start_usb_host
    start_usb_dev
}

case "$1" in
  start)
    start_usb
  ;;
  restart)
    restart_usb_dev
  ;;
  stop)
    start_usb_host
  ;;
  stop_start)
    start_usb_host
    start_usb_dev
  ;;
   restart_phy)
    restart_phy
  ;;
esac
