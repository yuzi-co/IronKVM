#!/bin/sh
# nanokvm Rev3.1

# libkvm reports a capture pipeline that does not start with printf, and the
# server used to send that output nowhere: to the console at boot, and to
# /dev/null after a scripted restart. Both are lost, so every earlier attempt
# to explain the intermittent failure had no error code to work from.
#
# Send the output to tmpfs instead. S99vidiag follows this file and copies the
# few lines that matter to /data, which survives a reboot. The path is under
# /tmp because /kvmapp is the boot SD card.
#
# The server sets line buffering for stdout at startup. Without that the C
# messages wait in libc for the process to exit, and this file collects one
# line and then nothing. See server/common/libkvm_stdout.go.
#
# Empty the file before the copies below, not after them. libkvm prints on some
# error paths once per frame. A capture pipeline that fails in a loop therefore
# fills tmpfs, and the copy of /kvmapp/server then has no space for its 36MB. A
# copy that runs out of space leaves a truncated NanoKVM-Server, and the case
# starts it anyway. S99vidiag also empties this file, but only while its reader
# runs, so these cases must not depend on it.
SERVER_LOG=/tmp/nanokvm-server.log

# Where the runtime copy comes from and where it goes. Both are variables so
# tools/vidiag/test-server-copy.sh can drive the copy against a scratch tree
# instead of the boot SD card.
SERVER_SRC=${SERVER_SRC:-/kvmapp/server}
SERVER_DST=${SERVER_DST:-/tmp/server}

# kvm_system's runtime copy, named for the same reason: stop_services has to be
# able to reason about it, and tools/service/test-server-stop.sh has to be able
# to point it somewhere harmless. start_services writes it with `cp -r ... /tmp/`,
# which lands in this same place.
SYSTEM_DST=${SYSTEM_DST:-/tmp/kvm_system}

wait_for_exit() {
    process="$1"
    timeout="$2"
    elapsed=0

    while pidof "$process" >/dev/null 2>&1; do
        if [ "$elapsed" -ge "$timeout" ]; then
            return 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

# The first signal has to be one the processes can receive. Both of them start
# as background jobs of a shell without job control, and POSIX makes such a
# shell set SIGINT to SIG_IGN in the child. Measured on the device 2026-08-19,
# from /proc/<pid>/status: NanoKVM-Server ignores SIGINT and catches SIGTERM;
# kvm_system ignores SIGINT and SIGQUIT, catches nothing at all, and takes the
# default action on SIGTERM.
#
# So the SIGINT stage that used to come first reached no code in either process,
# and the twenty seconds it waited afterwards were spent on a signal that could
# not arrive. Two SIGINTs to a running server produced no log line and no exit
# after 21s. One SIGTERM was answered and the process left in 7s.
#
# Ten seconds, not five. The server bounds its own teardown with disposeTimeout
# in server/main.go, and then it exits whatever the teardown is still doing. A
# wait equal to that bound races a teardown that was going to finish, so the
# wait has to be longer than it. tools/service/test-server-stop-signals.sh reads
# the constant out of main.go rather than repeating it here, because the two
# drifting apart is the failure that matters.
#
# SIGKILL stays, and it stays last. It reaches no code, so it costs the ION
# carveout a leaked video buffer pool that no userspace action gives back. A
# process wedged in uninterruptible sleep answers nothing else, though, and the
# stop has to end.
stop_process() {
    process="$1"

    if ! pidof "$process" >/dev/null 2>&1; then
        return
    fi

    killall -TERM "$process" 2>/dev/null || true
    if wait_for_exit "$process" 10; then
        return
    fi

    killall -KILL "$process" 2>/dev/null || true
    wait_for_exit "$process" 2 || true
}

# The server starts arecord to read the USB audio gadget. The child does not
# die with its parent: it sees the closed pipe only when it writes, and while
# the managed host plays nothing it blocks in the ALSA read for as long as the
# board is up.
#
# An orphan holds hw:UAC1Gadget,0 exclusively, so the next server's arecord
# fails with "Device or resource busy", spends its restart budget in about
# three seconds, and gives up. Audio then stays dead until somebody logs in.
#
# The server also stops the child on SIGTERM, which is the path this script
# takes. This is here for the paths that reach no code in the server: a
# SIGKILL, a crash, and an operator who killed it by hand.
#
# The redirect hides the "no process killed" line, which is the normal case.
stop_audio_capture() {
    # SIGKILL, not SIGTERM. The child this exists for is one wedged in an ALSA
    # read on a gadget that has been torn down underneath it, and that child
    # does not answer SIGTERM. There is no state to flush.
    killall -9 arecord 2>/dev/null
}

stop_services() {
    # The server owns VI/VPSS. Let it release MMF before stopping kvm_system.
    stop_process NanoKVM-Server
    stop_process kvm_system

    # After the server is gone, or it starts a new child.
    stop_audio_capture

    # Remove a runtime copy only once nothing is running from it.
    #
    # These copies live in tmpfs, so one left behind is pinned RAM for as long
    # as the board is up, and removing them is worth doing. But a stop does not
    # always stop: this board has a server that outlives the signals above and
    # keeps answering. start_services then reads a live pidof and skips the
    # copy, because its job is to avoid starting a second one:
    #
    #     if ! pidof NanoKVM-Server >/dev/null 2>&1; then
    #         copy_server
    #
    # So an unconditional remove here leaves a running process whose whole tree
    # is gone. It answers the API, because routing is already in memory, and it
    # returns 404 for every file in the web UI, because the web root is derived
    # from its own executable path. Nothing logs it.
    #
    # Each copy is judged by its own process. They are started and stopped
    # separately, and one that stopped should not keep the other's copy in RAM.
    pidof NanoKVM-Server >/dev/null 2>&1 || rm -rf "$SERVER_DST"
    pidof kvm_system >/dev/null 2>&1 || rm -rf "$SYSTEM_DST"
}

# now_fps is rewritten whenever the measured frame rate changes, so a
# streaming session rewrites it for as long as it runs. The value means
# nothing across a reboot, and the card it lands on is the one the device
# boots from, so point the path at tmpfs and leave a symlink behind. Both
# readers keep the path they already use and neither needs rebuilding.
#
# kvm_system does not check the result of fopen before seeking on it, so a
# missing file crashes it. The target is created here, before anything reads
# it, and refreshed on restart in case tmpfs was cleared underneath us.
#
# state is the same shape of file. libkvm writes it from inside its frame read,
# with a shell, on every change of HDMI presence: "echo 1 > /kvmapp/kvm/state"
# when it starts getting frames and 0 when it stops. A source that comes and
# goes therefore writes to the boot medium on its own, with no user in the loop,
# and holds the capture mutex while it forks. The value describes this moment
# and means nothing after a reboot. kvm_system writes 0 into it at startup
# anyway, so tmpfs loses nothing.
#
# link_runtime_file points one of these names at tmpfs. It replaces a regular
# file with the link, so a board that has been running the old layout is
# converted on the next start.
link_runtime_file() {
    name=$1

    [ -e "/tmp/kvm/$name" ] || echo 0 > "/tmp/kvm/$name"

    if [ ! -L "/kvmapp/kvm/$name" ]; then
        rm -f "/kvmapp/kvm/$name"
        ln -s "/tmp/kvm/$name" "/kvmapp/kvm/$name"
    fi
}

prepare_runtime_state() {
    mkdir -p /tmp/kvm

    link_runtime_file now_fps
    link_runtime_file state
}

# is_backup reports whether a name is something a deploy left beside the file
# it replaced, rather than something the server runs.
is_backup() {
    case "$1" in
        *.prev|*.bak|*.old|*.rollback) return 0 ;;
    esac
    return 1
}

# copy_tree copies one directory into another, skipping backups at every depth.
# It recurses instead of calling `cp -r` on the whole tree, because an excluded
# name must never be written at all: a copy that lands first and is deleted
# afterwards still has to fit while it is there, and room is the constraint the
# order in start_services exists to protect.
copy_tree() {
    mkdir -p "$2"

    for entry in "$1"/* "$1"/.[!.]*; do
        [ -e "$entry" ] || continue

        name=${entry##*/}
        if is_backup "$name"; then
            echo "S95nanokvm: skipping backup $entry"
            continue
        fi

        if [ -d "$entry" ] && [ ! -L "$entry" ]; then
            copy_tree "$entry" "$2/$name"
        else
            cp -a "$entry" "$2/$name"
        fi
    done
}

# copy_server puts the server tree in tmpfs, which is RAM. A backup that rides
# along is pinned memory for as long as the board is up: two orphans measured
# on a device, web.rollback at 3.83MB and dl_lib/libkvm.so.prev at 1.48MB, cost
# 5.3MB of 166MB and neither was ever opened.
copy_server() {
    rm -rf "$SERVER_DST"
    copy_tree "$SERVER_SRC" "$SERVER_DST"
}

# The Go collector's only default input is how much the heap has grown since
# the last collection. It cannot see what the board has left. This board has
# 166MB Linux can address and about 96MB spare once the video carveout, the
# kernel and the running services are counted, and below roughly 30MB free it
# stops being able to start a process at all: fork fails, the kernel picks no
# victim, and only a power cycle clears it. The failure guarded against here is
# therefore not a killed server. It is a board that answers nothing and cannot
# be reached to repair it.
#
# GOMEMLIMIT supplies the missing input. The default is 64MiB, a little over
# twice the 27.8MB peak measured on the reference device over 26 hours
# (/proc/<pid>/status, VmHWM), which leaves the collector room to work before
# it becomes the thing that consumes the board.
#
# /etc/kvm/GOMEMLIMIT.server overrides it, in MiB. tailscaled reads its own
# /etc/kvm/GOMEMLIMIT, and the two stay separate on purpose: one number cannot
# suit both a VPN daemon and the process that has to answer the browser, and a
# value chosen for tailscaled would silently disable this one.
#
# The value is checked before it is used. Go refuses to start when GOMEMLIMIT
# does not parse, so a typo in that file would take the server down rather than
# merely mis-size it.
#
# No oom_score_adj is set here. The kernel on this board does not choose an OOM
# victim under the pressure this fork has measured; allocation stops working
# first. Lowering the score would read as protection while changing nothing.
server_memlimit() {
    dir=${MEMLIMIT_DIR:-/etc/kvm}
    value=

    if [ -r "$dir/GOMEMLIMIT.server" ]; then
        value=$(cat "$dir/GOMEMLIMIT.server" 2>/dev/null)
    fi

    case "$value" in
        "" | *[!0-9]*) value=64 ;;
        0)             value=64 ;;
    esac

    GOMEMLIMIT="${value}MiB"
    export GOMEMLIMIT
}

start_services() {
    prepare_runtime_state

    # Start each run with an empty file, so the log always describes the server
    # that is running now. S99vidiag has already copied what it read to /data.
    #
    # This runs before the copies below, not after them: a capture pipeline that
    # fails in a loop fills tmpfs, and the copy of /kvmapp/server then has no
    # room for its 36MB.
    : > "$SERVER_LOG"

    cp -r /kvmapp/kvm_system /tmp/
    if [ -f /kvmapp/kvm_new_app ]; then
        touch /tmp/.nanokvm_migrating
        /tmp/kvm_system/kvm_system &

        # The legacy migration invokes this init script recursively and starts
        # the server itself. Wait for that single migration path to finish.
        migration_wait=0
        while [ "$migration_wait" -lt 30 ]; do
            if [ ! -f /kvmapp/kvm_new_app ] && pidof NanoKVM-Server >/dev/null 2>&1; then
                rm -f /tmp/.nanokvm_migrating
                return
            fi
            sleep 1
            migration_wait=$((migration_wait + 1))
        done
        rm -f /tmp/.nanokvm_migrating
    else
        /tmp/kvm_system/kvm_system &
    fi

    if ! pidof NanoKVM-Server >/dev/null 2>&1; then
        copy_server
        server_memlimit
        echo "GOMEMLIMIT set to ${GOMEMLIMIT}"
        "$SERVER_DST/NanoKVM-Server" >> "$SERVER_LOG" 2>&1 &
    fi
}

case "$1" in
  start)
    echo -n kvm > /boot/hostname.prefix

    # Copy sensor config if the file exists
    [ -f /mnt/data/sensor_cfg.ini.LT ] && cp /mnt/data/sensor_cfg.ini.LT /mnt/data/sensor_cfg.ini

    # Generate unique device key
    if [ -f /sys/class/cvi-base/base_uid ]; then
        str_value=$(awk '{print $2}' /sys/class/cvi-base/base_uid)
        first_uint=$(echo "$str_value" | cut -d'_' -f1)
        second_uint=$(echo "$str_value" | cut -d'_' -f2)
        echo "$first_uint$second_uint" > /device_key
    fi

    # Set iptables rules (skip if already present)
    iptables -C INPUT -i eth0 -p tcp --dport 80 -m state --state NEW,ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A INPUT -i eth0 -p tcp --dport 80 -m state --state NEW,ESTABLISHED -j ACCEPT

    iptables -C OUTPUT -o eth0 -p tcp --sport 80 -m state --state ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A OUTPUT -o eth0 -p tcp --sport 80 -m state --state ESTABLISHED -j ACCEPT

    iptables -C INPUT -i eth0 -p tcp --sport 22 -m state --state NEW,ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A INPUT -i eth0 -p tcp --sport 22 -m state --state NEW,ESTABLISHED -j ACCEPT

    iptables -C OUTPUT -o eth0 -p tcp --dport 22 -m state --state ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A OUTPUT -o eth0 -p tcp --dport 22 -m state --state ESTABLISHED -j ACCEPT

    iptables -C OUTPUT -o eth0 -p tcp --sport 8000 -m state --state ESTABLISHED -j DROP 2>/dev/null || \
    iptables -A OUTPUT -o eth0 -p tcp --sport 8000 -m state --state ESTABLISHED -j DROP

    # Never answer DHCP on the wired network. udhcpd serves the USB and the
    # WiFi AP subnets, but it listens for 255.255.255.255 broadcasts, and the
    # kernel does not reliably confine that to the interface it was bound to.
    # A NanoKVM plugged into an office LAN then offers addresses from its own
    # private subnet to any machine that asks, which breaks them.
    #
    # These match the server port only, so the DHCP client that gives this
    # device its own address is untouched: it sends and listens on port 68,
    # and acquires its first lease over a raw socket that never reaches these
    # chains. Insert at the top so no earlier accept can win.
    if [ ! -e /boot/dhcp.eth0 ]; then
        iptables -C INPUT -i eth0 -p udp --dport 67 -j DROP 2>/dev/null || \
        iptables -I INPUT -i eth0 -p udp --dport 67 -j DROP

        iptables -C OUTPUT -o eth0 -p udp --sport 67 -j DROP 2>/dev/null || \
        iptables -I OUTPUT -o eth0 -p udp --sport 67 -j DROP
    fi

    # Logo selection. The served file is named for the firmware rather than for
    # the hardware vendor, and both the favicon and the login page point at it,
    # so /boot/logo.ico still replaces both exactly as it always did.
    if [ -f /boot/logo.ico ]; then
        if [ ! -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/ironkvm.ico /kvmapp/server/web/original.ico
            cp /boot/logo.ico /kvmapp/server/web/ironkvm.ico
        fi
    else
        if [ -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/original.ico /kvmapp/server/web/ironkvm.ico
        fi
    fi

    # Start services
    start_services
   ;;

  stop)
    stop_services
    echo "OK"
   ;;

  restart)
    if [ -f /tmp/.nanokvm_migrating ]; then
        exit 0
    fi
    stop_services
    start_services

    sync
    echo "OK"
   ;;
    
  # Not for an operator. tools/vidiag/test-server-copy.sh calls this with
  # SERVER_SRC and SERVER_DST pointed at a scratch tree, the way S99vidiag and
  # S98supervise expose their own loops.
  __copy_server)
    copy_server
   ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
  ;;
esac
