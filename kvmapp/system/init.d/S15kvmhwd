#!/bin/sh
# kvmhwd Rev2.5
#
# This file is a wrapper. Everything below "the old way" is Sipeed's script,
# unchanged in what it does, and everything above it is the path an IronKVM
# image takes instead.
#
# == Why there are two paths ==
#
# ironkvm-dist moves this work into device hooks: ironkvm-hwinit runs the pinmux
# stage, ironkvm-board runs the detection hooks and writes one board
# description, and a late hook mirrors that description into /etc/kvm/hw and
# /etc/kvm/hdmi_version for the vendor code that reads them. An image built by
# ironkvm-dist installs both tools in /usr/bin.
#
# A board that runs Sipeed's firmware has neither. It has this application
# tarball and nothing else, and it has to keep booting exactly as it does today.
# So when either tool is missing, this script runs the old code, and the old
# code is kept here for that reason alone.
#
# The old code has a bug and it is kept. kvm_hw_detect opens with
#
#     if [ ! -e /etc/kvm/hdmi_version ]; then rm /etc/kvm/hw; fi
#
# while kvm_hdmi_version_detect runs on the beta and pcie path only, so an alpha
# board never has /etc/kvm/hdmi_version from detection and re-probes on every
# boot. The new path does not inherit it, because it asks the description
# whether the board has been detected and the description is one file. Fixing it
# in the old path would change what a board on Sipeed's firmware does, and that
# is not what this change is for.
#
# == What calls this ==
#
# kvm_system is a binary this project cannot rebuild. It calls exactly two of
# these subcommands, and it copies this file from /kvmapp/system/init.d into
# /etc/init.d when an application update runs, so both copies have to work:
#
#     /kvmapp/system/init.d/S15kvmhwd get_hdmi_version   system_init.cpp
#     /etc/init.d/S15kvmhwd start                        system_init.cpp
#
# kvm_vision calls get_hdmi_version as well. Both read /etc/kvm/hdmi_version
# afterwards and ignore what this prints, so the file is the answer and the
# printed line is a convenience.
#
# re-detect and re-init keep their old arguments although nothing calls them,
# and an unknown argument still exits 0 and does nothing. That surface is what a
# vendor binary sees and this change is about keeping it still.
#
# == What the new path does not do ==
#
# It does not reboot. The pcie variant needs one reboot after it is found, and
# the latch that grants it belongs to `ironkvm-board reboot-if-required`, which
# S02hwlate calls at boot. A reboot from here would happen while kvm_system is
# mid-update.
#
# It does not write /etc/kvm/hw either. The late hook mirrors the description
# into that file, and by the time this runs at S15 the late stage has already
# been through. `start` only makes sure the board is detected and the pins are
# muxed, and both of those are repeatable.
#
# Every path here is written out in full, /etc/kvm and /sys/class/gpio alike,
# and none of them is a variable. Two suites in ironkvm-dist parse the pin
# numbers, the register writes and the variant names straight out of this file
# so that the hooks which replace it cannot drift from it, and a variable would
# leave them nothing to read. tools/hwd/test-s15kvmhwd.sh rewrites the paths in
# a copy instead, and refuses to run if any of them survives the rewrite.

Alpha_OLED_RST_Pin=371
Beta_OLED_RST_Pin=502
Beta_OLED_SCL=595
Beta_OLED_SDA=507
WiFi_EN_Pin=506
Alpha_PWR_LED_Pin=504
Alpha_HDD_LED_Pin=505
Alpha_PWR_KEY_Pin=503
Alpha_RST_KEY_Pin=507
Beta_PWR_LED_Pin=504
Beta_PWR_KEY_Pin=503
Beta_RST_KEY_Pin=505
PCIe_HDMI_RST_Pin=451

# --------------------------------------------------------------- the new way

# Both tools or neither. ironkvm-board without the hook runner would detect the
# board and leave the pins unmuxed, which is a worse board than either path
# gives on its own.
have_ironkvm_tools() {
  command -v ironkvm-board > /dev/null 2>&1 || return 1
  command -v ironkvm-hwinit > /dev/null 2>&1 || return 1
  return 0
}

# The bridge the description names, or nothing. An alpha board has no
# hdmi_bridge key, and neither has a board that has not been detected yet.
described_hdmi_bridge() {
  have_ironkvm_tools || return 0
  ironkvm-board get hdmi_bridge 2> /dev/null
}

# Write the file only when it does not already say this, for the reason the
# mirror hook gives: /etc/kvm is on the boot card.
write_hdmi_version() {
  if [ -f "/etc/kvm/hdmi_version" ] && [ "$(cat "/etc/kvm/hdmi_version")" = "$1" ]
  then
    return 0
  fi
  [ -d "/etc/kvm" ] || mkdir -p "/etc/kvm"
  printf '%s\n' "$1" > "/etc/kvm/hdmi_version"
}

# get_hdmi_version answers from the description where the description has the
# answer, and probes the bus where it does not. An alpha board is the second
# case: it has no hdmi_bridge key, and kvm_system has always got a probed value
# there, so the probe is what keeps that board unchanged.
kvm_get_hdmi_version() {
  bridge=$(described_hdmi_bridge)
  if [ -n "$bridge" ]
  then
    write_hdmi_version "$bridge"
  else
    kvm_hdmi_version_detect
  fi
  [ -f "/etc/kvm/hdmi_version" ] && cat "/etc/kvm/hdmi_version"
  return 0
}

# --------------------------------------------------------------- the old way
#
# Sipeed's script from here down, byte for byte, with one change and no others:
# the case statement at the end asks have_ironkvm_tools first. This code runs on
# a board that has no ironkvm-board, and it behaves exactly as the release it
# came from, the alpha re-probe included.

init_alpha_hw(){
  devmem 0x030010D0 32 0x2  # I2C1_SCL
  devmem 0x030010DC 32 0x2  # I2C1_SDA
  devmem 0x030010D4 32 0x3  # OLED_RST
  devmem 0x0300103C 32 0x3  # GPIOA15
  devmem 0x03001050 32 0x3  # GPIOA22
  devmem 0x0300105C 32 0x3  # GPIOA23
  devmem 0x03001060 32 0x3  # GPIOA24
  devmem 0x03001054 32 0x3  # GPIOA25
  devmem 0x03001058 32 0x3  # GPIOA27

	devmem 0x03001068 32 0x6  # GPIOA 18 UART1 RX
	devmem 0x03001064 32 0x6  # GPIOA 19 UART1 TX
	devmem 0x03001070 32 0x2  # GPIOA 28 UART2 TX
	devmem 0x03001074 32 0x2  # GPIOA 29 UART2 RX

  echo ${Alpha_OLED_RST_Pin} > /sys/class/gpio/export  # OLED_RST
  echo out > /sys/class/gpio/gpio${Alpha_OLED_RST_Pin}/direction
  echo 1 > /sys/class/gpio/gpio${Alpha_OLED_RST_Pin}/value

  echo ${Alpha_PWR_LED_Pin} > /sys/class/gpio/export   # pwr led
  echo ${Alpha_HDD_LED_Pin} > /sys/class/gpio/export   # hdd led
  echo ${Alpha_PWR_KEY_Pin} > /sys/class/gpio/export   # pwr key
  echo ${Alpha_RST_KEY_Pin} > /sys/class/gpio/export   # rst key

  echo in > /sys/class/gpio/gpio${Alpha_PWR_LED_Pin}/direction     # pwr led
  echo in > /sys/class/gpio/gpio${Alpha_HDD_LED_Pin}/direction     # hdd led
  echo out > /sys/class/gpio/gpio${Alpha_PWR_KEY_Pin}/direction    # pwr key
  echo out > /sys/class/gpio/gpio${Alpha_RST_KEY_Pin}/direction    # rst key

  rmmod /mnt/system/ko/i2c-gpio.ko
  rmmod /mnt/system/ko/i2c-algo-bit.ko

  # rm /etc/init.d/S25wifimod
  # rm /etc/init.d/S30wifi
}

init_beta_pcie_hw(){
  devmem 0x0300103C 32 0x3  # GPIOA15
  devmem 0x03001050 32 0x3  # GPIOA22
  devmem 0x0300105C 32 0x3  # GPIOA23
  devmem 0x03001060 32 0x3  # GPIOA24
  devmem 0x03001054 32 0x3  # GPIOA25
  devmem 0x03001058 32 0x3  # GPIOA27

  devmem 0x030010E4 32 0x0  # SDIO CLK
  devmem 0x030010E0 32 0x0  # SDIO CMD
  devmem 0x030010DC 32 0x0  # SDIO D0
  devmem 0x030010D8 32 0x0  # SDIO D1
  devmem 0x030010D4 32 0x0  # SDIO D2
  devmem 0x030010D0 32 0x0  # SDIO D3

	devmem 0x03001068 32 0x6  # GPIOA 18 UART1 RX
	devmem 0x03001064 32 0x6  # GPIOA 19 UART1 TX
	devmem 0x03001070 32 0x2  # GPIOA 28 UART2 TX
	devmem 0x03001074 32 0x2  # GPIOA 29 UART2 RX

  echo ${Beta_OLED_RST_Pin} > /sys/class/gpio/export  # Beta OLED_RST
  echo out > /sys/class/gpio/gpio${Beta_OLED_RST_Pin}/direction
  echo 1 > /sys/class/gpio/gpio${Beta_OLED_RST_Pin}/value

  echo ${Beta_PWR_LED_Pin} > /sys/class/gpio/export   # pwr led
  echo ${Beta_PWR_KEY_Pin} > /sys/class/gpio/export   # pwr key
  echo ${Beta_RST_KEY_Pin} > /sys/class/gpio/export   # rst key
  echo ${PCIe_HDMI_RST_Pin} > /sys/class/gpio/export   # hdmi rst key

  echo in > /sys/class/gpio/gpio${Beta_PWR_LED_Pin}/direction     # pwr led
  echo out > /sys/class/gpio/gpio${Beta_PWR_KEY_Pin}/direction    # pwr key
  echo out > /sys/class/gpio/gpio${Beta_RST_KEY_Pin}/direction    # rst key
  echo out > /sys/class/gpio/gpio${PCIe_HDMI_RST_Pin}/direction    # rst key

  echo 1 > /sys/class/gpio/gpio${PCIe_HDMI_RST_Pin}/value    # rst key

  rmmod /mnt/system/ko/i2c-gpio.ko
  rmmod /mnt/system/ko/i2c-algo-bit.ko
  insmod /mnt/system/ko/i2c-algo-bit.ko
  insmod /mnt/system/ko/i2c-gpio.ko
}

kvm_hw_detect(){
  if [ ! -e /etc/kvm/hdmi_version ]
  then
    rm /etc/kvm/hw
  fi
  if [ -e /etc/kvm/hw ]
  then
    echo "/etc/kvm/hw exist"
  else
    echo "/etc/kvm/hw not exist"
    if [ -d "/etc/kvm/" ]
    then
      echo "/etc/kvm/ exist"
    else
      mkdir /etc/kvm/
    fi
    devmem 0x0300104C 32 0x3  # GPIOA26 / WiFi_EN
    echo ${WiFi_EN_Pin} > /sys/class/gpio/export  # WiFi_EN
    echo out > /sys/class/gpio/gpio${WiFi_EN_Pin}/direction
    echo 0 > /sys/class/gpio/gpio${WiFi_EN_Pin}/value

    devmem 0x0300103C 32 0x3  # GPIOA15
    devmem 0x03001050 32 0x3  # GPIOA22
    devmem 0x0300105C 32 0x3  # GPIOA23
    devmem 0x03001060 32 0x3  # GPIOA24
    devmem 0x03001054 32 0x3  # GPIOA25
    devmem 0x03001058 32 0x3  # GPIOA27

    devmem 0x030010D0 32 0x2  # I2C1_SCL
    devmem 0x030010DC 32 0x2  # I2C1_SDA
    devmem 0x030010D4 32 0x3  # OLED_RST
    echo ${Alpha_OLED_RST_Pin} > /sys/class/gpio/export  # OLED_RST
    echo out > /sys/class/gpio/gpio${Alpha_OLED_RST_Pin}/direction
    echo 1 > /sys/class/gpio/gpio${Alpha_OLED_RST_Pin}/value

    kvm_tmp=$(i2cdetect -ry 1 0x3d 0x3d | grep 3d)
    if [ -n "$kvm_tmp" ]
    then
      # alpha hw
      echo "alpha" > /etc/kvm/hw
    else
      # beta/pcie hw
      echo ${Alpha_OLED_RST_Pin} > /sys/class/gpio/unexport  # OLED_RST
      echo ${Beta_OLED_RST_Pin} > /sys/class/gpio/export  # Beta_OLED_RST_Pin
      echo out > /sys/class/gpio/gpio${Beta_OLED_RST_Pin}/direction
      echo 1 > /sys/class/gpio/gpio${Beta_OLED_RST_Pin}/value

      rmmod /mnt/system/ko/i2c-gpio.ko
      rmmod /mnt/system/ko/i2c-algo-bit.ko
      insmod /mnt/system/ko/i2c-algo-bit.ko
      insmod /mnt/system/ko/i2c-gpio.ko

      kvm_hdmi_version_detect

      kvm_tmp=$(i2cdetect -ry 5 0x3c 0x3c | grep 3c)
      if [ -n "$kvm_tmp" ]
      then
        echo "pcie" > /etc/kvm/hw
        sync
        reboot
      else
        echo "beta" > /etc/kvm/hw
        # rm /etc/init.d/S25wifimod
        # rm /etc/init.d/S30wifi
        sync
      fi

      echo 1 > /sys/class/gpio/gpio${WiFi_EN_Pin}/value
      echo ${WiFi_EN_Pin} > /sys/class/gpio/unexport  # WiFi_EN
    fi
  fi
  sync
}

kvm_hw_init(){
    FIND_FILE="/etc/kvm/hw"
    if [ `grep -c "alpha" $FIND_FILE` -ne '0' ]
    then
        echo "hw = alpha!"
        init_alpha_hw
    fi
    if [ `grep -c "beta" $FIND_FILE` -ne '0' ]
    then
        echo "hw = beta!"
        init_beta_pcie_hw
    fi
    if [ `grep -c "pcie" $FIND_FILE` -ne '0' ]
    then
        echo "hw = pcie!"
        init_beta_pcie_hw
    fi
}

kvm_hdmi_version_detect()
{
    if i2cdetect -ry 4 0x2c 0x2c | grep -qw "2c"; then
        echo "c" > /etc/kvm/hdmi_version
    elif i2cdetect -ry 4 0x2b 0x2b | grep -qw "2b"; then
        if i2cdetect -ry 4 0x44 0x44 | grep -qw "44"; then
            echo "ux" > /etc/kvm/hdmi_version
        else
            echo "d" > /etc/kvm/hdmi_version
        fi
    else
        echo "ue" > /etc/kvm/hdmi_version
    fi
}

case "$1" in
  start)
    if have_ironkvm_tools
    then
      ironkvm-board detect
      ironkvm-hwinit pinmux
    else
      kvm_hw_detect
      kvm_hw_init
    fi
  ;;
  re-detect)
    if have_ironkvm_tools
    then
      ironkvm-board detect --again
      ironkvm-hwinit pinmux
    else
      rm /etc/kvm/hw
      kvm_hw_detect
      kvm_hw_init
    fi
  ;;
  re-init)
    if have_ironkvm_tools
    then
      ironkvm-hwinit pinmux
    else
      kvm_hw_init
    fi
  ;;
  get_hdmi_version)
    kvm_get_hdmi_version
  ;;
esac
