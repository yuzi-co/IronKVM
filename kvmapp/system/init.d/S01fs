#!/bin/sh

# --- data device ---
# Where /data lives, from configuration rather than from a partition number.
#
# The A/B layout puts root B on p3 and /data on p6. This script mounted
# /dev/mmcblk0p3 on /data directly, so the first A/B boot left /data unmounted,
# S02identity had nothing to bind, and the board came up with the image's own
# /etc/kvm rather than the device's.
#
# /etc/nanokvm-slots.conf is written into every image by tools/abslots. A board
# that has not been migrated has no such file and keeps the old behaviour, which
# is why the fallback is p3 rather than an error.
SLOT_CONF=${SLOT_CONF:-/etc/nanokvm-slots.conf}

data_device() {
    if [ -r "$SLOT_CONF" ]; then
        DATA_DEV=
        . "$SLOT_CONF"
        if [ -n "$DATA_DEV" ]; then
            echo "$DATA_DEV"
            return 0
        fi
    fi
    echo /dev/mmcblk0p3
}
# --- end data device ---

# --- data mount ---
# /data is exfat, which stores no POSIX mode, so every file on it takes its
# mode from the mount. The board keeps its root password hash and its
# authorized_keys there, and 0755 for those two is wrong even on a board whose
# only login user is root.
#
# fmask and dmask exist only on the FAT family. If /data is ever another
# filesystem the masked mount fails, and an unmounted /data is the fault this
# script was fixed for on 2026-08-16. So fall back to a plain mount rather than
# leave /data unmounted, and report failure only when neither works.
mount_data() {
        mount -o fmask=0077,dmask=0077 "$1" "$2" 2>/dev/null && return 0
        mount "$1" "$2"
}
# --- end data mount ---

# --- autopartition guard ---
# The /boot/usb.disk0 branch below runs `parted mkpart` and then
# `mkfs.exfat /dev/mmcblk0p3`. On a card that declares an A/B layout, p3 is a
# root filesystem and that would format it.
#
# The branch is already gated on /etc/kvm.disk0, and the image manifest creates
# that marker, which is what stopped it on the first real A/B boot. This is the
# second lock: a layout that names its own devices has been partitioned
# deliberately and must never be repartitioned by a boot script.
may_autopartition() {
    [ -r "$SLOT_CONF" ] && return 1
    return 0
}
# --- end autopartition guard ---

# --- partition probes ---
part3_exists() {
    [ -e /dev/mmcblk0p3 ]
}

# The end of p2 in MB, from the machine-readable partition table.
p2_end_mb() {
    parted -sm /dev/mmcblk0 unit MB print 2>/dev/null \
        | awk -F: '/^2:/{gsub(/[^0-9.]/, "", $3); print int($3)}'
}

# 8192MB, unless the card is smaller than that, in which case the whole card is
# as far as p2 can ever reach.
target_mb() {
    disk=$(parted -sm /dev/mmcblk0 unit MB print 2>/dev/null \
        | awk -F: 'NR==2{gsub(/[^0-9.]/, "", $2); print int($2)}')
    if [ -n "$disk" ] && [ "$disk" -lt 8192 ]; then
        echo "$disk"
    else
        echo 8192
    fi
}
# --- end partition probes ---

# --- resize guard ---
# p2 is grown to 8192MB on a fresh card, and the stock script does it on every
# boot. That rewrites the partition table each time for no gain: the resize is a
# no-op once p2 already reaches the target, and it cannot succeed at all once p3
# exists, because p3 starts immediately above p2. The cost is SD wear on the one
# structure the board cannot boot without, and a power cut during the write is
# the way to lose it.
#
# Both tests read the partition table rather than a marker file. A marker in the
# root filesystem would not survive a slot image built from a fresh rootfs,
# while the partition table is the same for every slot on the card.
#
# If the table cannot be read, resize. Behaving like the stock script is the
# safe direction: a fresh card that needs the resize must still get it.
needs_resize() {
    part3_exists && return 1

    end=$(p2_end_mb)
    [ -n "$end" ] || return 0

    [ "$end" -ge "$(target_mb)" ] && return 1
    return 0
}
# --- end resize guard ---

if [ "$1" = "start" ]
then
        if needs_resize
        then
                # use all sdcard free space for data
                parted -s /dev/mmcblk0 "resizepart 2 -0"
                echo "yes
                8192MB
                " | parted ---pretend-input-tty /dev/mmcblk0 "resizepart 2 8192MB"
                # resize data filesystem
                (resize2fs /dev/mmcblk0p2) &
        fi


        . /etc/profile
        printf "mounting filesystem : "
        mkdir -p /boot
        mount -t vfat /dev/mmcblk0p1 /boot
        mount -t configfs configfs /sys/kernel/config
        mount -t debugfs debugfs /sys/kernel/debug

        if [ -e /boot/usb.disk0 ] && may_autopartition
        then
                if [ ! -e /etc/kvm.disk0 ]
                then
                        touch /etc/kvm.disk0
                        # use all sdcard free space for data
                        parted -s /dev/mmcblk0 "mkpart primary 8193MB 100%"
                        sleep 1
                        # resize data filesystem
                        (mkfs.exfat /dev/mmcblk0p3) &
                        sleep 1
                fi
        fi

        DATADEV=$(data_device)
        if [ -e "$DATADEV" ]
        then
                mkdir -p /data
                mount_data "$DATADEV" /data
                printf "(data on %s) " "$DATADEV"
        else
                printf "(no data device at %s) " "$DATADEV"
        fi

        echo "OK"
fi
