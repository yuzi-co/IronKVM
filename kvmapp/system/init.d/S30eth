#!/bin/sh

# The wired interface. A second board names it something else, so the name is a
# fact about the board and comes from the description. eth0 stays the default,
# so a board whose description says nothing about it gets exactly what this
# script has always done.
#
# The reader is found in two steps, the same two S01fs, S01zram and S01hwdt
# take. An image built by ironkvm-dist installs it at /usr/bin/ironkvm-deviceinfo,
# so the bare name resolves through PATH. A board that runs Sipeed's firmware
# installs the application tarball instead, and that install.sh comes from the
# official base tarball, which the fork cannot change: nothing puts the reader
# on PATH there. So the second step is the copy the tarball carries.
#
# Only the default is resolved this way. A DEVINFO from the environment is used
# as it is, including one that names a path which does not exist, because that
# is how the suites drive the missing reader case.
DEVINFO=${DEVINFO:-ironkvm-deviceinfo}
DEVINFO_TARBALL=${DEVINFO_TARBALL:-/kvmapp/system/ironkvm-deviceinfo}
if [ "$DEVINFO" = ironkvm-deviceinfo ] && ! command -v "$DEVINFO" > /dev/null 2>&1
then
    DEVINFO=$DEVINFO_TARBALL
fi

IF=$("$DEVINFO" get ETH_IF 2>/dev/null)
IF=${IF:-eth0}

# The address this script falls back to when there is no static configuration
# and no DHCP answer. It looks like a device fact and it is not: the fork chose
# this address, every board that runs this script falls back to the same one,
# and there is no key for it in the description.
RESERVE_INET="192.168.90.1/22"

clean_line() {
    echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g'
}

calc_gw() {
    addr="$1"
    netid="$2"
    IFS=. read a b c d <<EOF
$addr
EOF
    ipnum=$(( (a<<24) + (b<<16) + (c<<8) + d ))
    mask=$(( 0xFFFFFFFF << (32-netid) & 0xFFFFFFFF ))
    gwnum=$(( (ipnum & mask) | 1 ))
    if [ $gwnum -eq $ipnum ]; then
        broadcast=$(( (ipnum & mask) | (0xFFFFFFFF & ~mask) ))
        gwnum=$(( broadcast - 1 ))
    fi
    echo "$(( (gwnum>>24)&255 )).$(( (gwnum>>16)&255 )).$(( (gwnum>>8)&255 )).$(( gwnum&255 ))"
}

start() {
    # -4 keeps the IPv6 addresses, the link-local included. A bare flush drops
    # them and the kernel does not restore them while the interface stays up.
    # At boot that is invisible, because the link comes up afterwards. This
    # script also runs on every revert of an address trial, and there it costs
    # the board its IPv6 until somebody bounces the link.
    ip -4 addr flush dev "$IF"
    if [ -e /boot/eth.nodhcp ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=$(clean_line "$line")
            [ -z "$line" ] && continue
            set -- $line
            inet="$1"
            gw="$2"
            [ -z "$inet" ] && continue
            # Check if inet contains a valid netmask, if not, add default /16
            case "$inet" in
                */*)
                    # Already has netmask, check if valid (1-32)
                    netid_check=${inet#*/}
                    if ! echo "$netid_check" | grep -qE '^[0-9]+$' || [ $netid_check -lt 1 ] 2>/dev/null || [ $netid_check -gt 32 ] 2>/dev/null; then
                        inet="${inet%/*}/16"
                    fi
                    ;;
                *)
                    # No netmask, add default /16
                    inet="$inet/16"
                    ;;
            esac
            addr=${inet%/*}
            netid=${inet#*/}
            [ -z "$gw" ] && gw=$(calc_gw "$addr" "$netid")
            arping -Dqc2 -I"$IF" "$addr" || continue
            ip a add "$inet" brd + dev "$IF"
            ip r add default via "$gw" dev "$IF"
            echo -e "nameserver $gw" >> /etc/resolv.conf
            break
        done < /boot/eth.nodhcp

        ip a show dev "$IF" | grep inet > /dev/null || {
            udhcpc -i "$IF" -t 3 -T 1 -A 5 -O 121 -B -b -p "/run/udhcpc.$IF.pid" &>/dev/null
            ip a show dev "$IF" | grep inet > /dev/null
        } || {
            inet=$RESERVE_INET
            addr=${inet%/*}
            ip a add "$inet" brd + dev "$IF"
        } || exit 1
    else
        udhcpc -i "$IF" -t 10 -T 1 -A 5 -O 121 -B -b -p "/run/udhcpc.$IF.pid" &
    fi
}

stop() {
    [ ! -e "/run/udhcpc.$IF.pid" ] && exit 1
    kill "$(cat "/run/udhcpc.$IF.pid")"
    rm "/run/udhcpc.$IF.pid"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload)
        $0 stop
        $0 start
        ;;
    *) exit 1 ;;
esac