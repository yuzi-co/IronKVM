#!/bin/sh

# PicoClaw is not in the image. The server downloads it when the owner installs
# it from the web UI: on a distribution image into the add-on's directory on
# /data, with a link at /usr/bin/picoclaw that S04addons puts back at every
# boot, and anywhere else to /usr/bin/picoclaw itself. The add-on's copy is
# taken directly, so the link is not needed to start it: in its squashfs image,
# mounted at sqfs/ in the add-on's directory, or, on a slot that cannot mount
# one, as a plain file there. Without an install, start does nothing.
ADDON_IMAGE_BIN=${PICOCLAW_ADDON_IMAGE_BIN:-/data/ironkvm/addons/picoclaw/sqfs/picoclaw}
ADDON_BIN=${PICOCLAW_ADDON_BIN:-/data/ironkvm/addons/picoclaw/picoclaw}
if [ -n "${PICOCLAW_BIN_PATH:-}" ]; then
  BIN_PATH=$PICOCLAW_BIN_PATH
elif [ -x "$ADDON_IMAGE_BIN" ]; then
  BIN_PATH=$ADDON_IMAGE_BIN
elif [ -x "$ADDON_BIN" ]; then
  BIN_PATH=$ADDON_BIN
else
  BIN_PATH=/usr/bin/picoclaw
fi
LOG_FILE="${PICOCLAW_LOG_FILE:-/tmp/picoclaw.log}"
KVMDIR=${KVMDIR:-/etc/kvm}
BIN_NAME="$(basename "$BIN_PATH")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

resolve_user_home() {
  user_name="$(id -un 2>/dev/null || echo root)"
  user_home="$(awk -F: -v user="$user_name" '$1 == user { print $6; exit }' /etc/passwd)"
  if [ -n "$user_home" ] && [ -d "$user_home" ]; then
    printf '%s\n' "$user_home"
    return 0
  fi

  if [ -n "${HOME:-}" ] && [ -d "${HOME}" ]; then
    printf '%s\n' "$HOME"
    return 0
  fi

  printf '%s\n' "/root"
}

setup_picoclaw_home() {
  USER_HOME="$(resolve_user_home)"
  PICOCLAW_HOME="${PICOCLAW_HOME:-$USER_HOME/.picoclaw}"
  HOME="$USER_HOME"
  export HOME
  export PICOCLAW_HOME

  mkdir -p "$PICOCLAW_HOME" || {
    echo "failed to create picoclaw home: $PICOCLAW_HOME"
    return 1
  }
  PICOCLAW_PID_FILE="${PICOCLAW_PID_FILE:-$PICOCLAW_HOME/.picoclaw.pid}"
  export PICOCLAW_PID_FILE

  cd "$PICOCLAW_HOME" || {
    echo "failed to enter picoclaw home: $PICOCLAW_HOME"
    return 1
  }
}

setup_runtime_env() {
  [ -x "$BIN_PATH" ] || {
    echo "picoclaw binary not found: $BIN_PATH"
    return 1
  }

  setup_picoclaw_home || return 1
}

read_pid_file() {
  [ -f "$PICOCLAW_PID_FILE" ] || return 1
  pid="$(sed -n '1p' "$PICOCLAW_PID_FILE" 2>/dev/null | tr -d '[:space:]')"
  case "$pid" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  printf '%s\n' "$pid"
}

is_gateway_pid() {
  pid="$1"
  [ -n "$pid" ] || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1

  cmd_path="$(tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null | sed -n '1p')"
  subcommand="$(tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null | sed -n '2p')"
  [ "$(basename "$cmd_path")" = "$BIN_NAME" ] && [ "$subcommand" = "gateway" ] && return 0

  return 1
}

find_gateway_pid() {
  for proc_dir in /proc/[0-9]*; do
    [ -d "$proc_dir" ] || continue
    pid="${proc_dir#/proc/}"
    if is_gateway_pid "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
  done

  return 1
}

cleanup_stale_pid_file() {
  [ -f "$PICOCLAW_PID_FILE" ] || return 0
  pid="$(read_pid_file 2>/dev/null)" || {
    rm -f "$PICOCLAW_PID_FILE"
    return 0
  }
  if ! is_gateway_pid "$pid"; then
    echo "picoclaw stale pid file removed: $PICOCLAW_PID_FILE"
    rm -f "$PICOCLAW_PID_FILE"
  fi
}

gateway_running_pid() {
  pid="$(read_pid_file 2>/dev/null)" && is_gateway_pid "$pid" && {
    printf '%s\n' "$pid"
    return 0
  }

  cleanup_stale_pid_file
  pid="$(find_gateway_pid 2>/dev/null)" || return 1
  printf '%s\n' "$pid" >"$PICOCLAW_PID_FILE" 2>/dev/null || true
  printf '%s\n' "$pid"
}

# The kvm-control skill drove the KVM through a shell script. PicoClaw now
# runs without exec or skills and reaches the KVM only through the nanokvm
# MCP server, so remove the copy older versions placed in the workspace.
remove_kvm_control_skill() {
  target_dir="$PICOCLAW_HOME/workspace/skills/kvm-control"
  rm -rf "$target_dir" || {
    echo "failed to remove old kvm-control skill: $target_dir"
    return 1
  }
}

sync_agent_profile() {
  source_file="/kvmapp/picoclaw/AGENT_KVM.md"
  target_file="$PICOCLAW_HOME/workspace/AGENT.md"
  workspace_dir="$PICOCLAW_HOME/workspace"

  [ -f "$source_file" ] || {
    echo "agent profile source not found: $source_file"
    return 1
  }

  mkdir -p "$workspace_dir" || {
    echo "failed to create workspace directory: $workspace_dir"
    return 1
  }

  cp -f "$source_file" "$target_file" || {
    echo "failed to copy agent profile to $target_file"
    return 1
  }
}

# --- memlimit ---
# The Go memory limit, in MiB. /etc/kvm/GOMEMLIMIT.picoclaw is the owner's
# setting, and without it the limit is 32. A value that is not a whole number
# is ignored: Go refuses to start under a GOMEMLIMIT it cannot parse.
#
# PicoClaw shares the addons group with a VPN daemon, which keeps 56 MiB for
# itself (S98tailscaled, S98netbird). The kernel throttles the group at
# memory.high and Go frees memory only as its heap nears GOMEMLIMIT, so the
# limit is capped at seven eighths of what memory.high leaves after the VPN's
# 56: 35 for 96M, where the default of 32 stands. The cap applies to an
# owner's setting too, and is never under 8.
memlimit_mib() {
    mib=32
    if [ -f "$KVMDIR/GOMEMLIMIT.picoclaw" ]; then
        v=$(cat "$KVMDIR/GOMEMLIMIT.picoclaw" 2>/dev/null)
        case "$v" in
            ''|*[!0-9]*|0) ;;
            *) mib=$v ;;
        esac
    fi
    high=$(cat "${ADDONS_CGROUP:-/sys/fs/cgroup/addons}/memory.high" 2>/dev/null)
    case "$high" in
        ''|*[!0-9]*) ;;
        *)
            cap=$(( (high / 1048576 - 56) * 7 / 8 ))
            [ "$cap" -lt 8 ] && cap=8
            [ "$cap" -lt "$mib" ] && mib=$cap
            ;;
    esac
    echo "$mib"
}
# --- end memlimit ---

start_service() {
  if [ ! -x "$BIN_PATH" ]; then
    echo "picoclaw is not installed, nothing to start"
    return 0
  fi
  setup_runtime_env || return 1

  if pid="$(gateway_running_pid)"; then
    echo "picoclaw gateway already running (PID: $pid)"
    return 0
  fi

  if [ ! -f "$PICOCLAW_HOME/config.json" ]; then
    echo "picoclaw config not found: $PICOCLAW_HOME/config.json"
    return 1
  fi

  # Installs onboarded before the skill was dropped still carry a copy.
  remove_kvm_control_skill || return 1

  GOMEMLIMIT="$(memlimit_mib)MiB" "$BIN_PATH" gateway >>"$LOG_FILE" 2>&1 &
  gateway_pid="$!"
  printf '%s\n' "$gateway_pid" >"$PICOCLAW_PID_FILE" || {
    echo "failed to write picoclaw pid file: $PICOCLAW_PID_FILE"
    return 1
  }
  echo "picoclaw gateway started (PID: $gateway_pid)"
}

onboard_service() {
  setup_runtime_env || return 1
  "$BIN_PATH" onboard >>"$LOG_FILE" 2>&1 || return 1
  remove_kvm_control_skill || return 1
  sync_agent_profile || return 1
}

stop_service() {
  setup_picoclaw_home || return 1

  pid="$(gateway_running_pid 2>/dev/null)" || {
    cleanup_stale_pid_file
    return 0
  }

  kill "$pid" 2>/dev/null || true
  count=0
  while is_gateway_pid "$pid"; do
    count=$((count + 1))
    if [ "$count" -ge 15 ]; then
      echo "picoclaw gateway did not stop after TERM, killing PID: $pid"
      kill -9 "$pid" 2>/dev/null || true
      break
    fi
    sleep 1
  done

  rm -f "$PICOCLAW_PID_FILE"
}

# --- cgroup ---
# ironkvm-dist's S01cgroups makes an addons memory group with a soft and a
# hard limit, and under it addons/daemons, which holds one leaf group per host
# add-on. This script joins its own leaf, addons/daemons/picoclaw, before it
# starts the gateway, so the gateway inherits it however the script is run:
# at boot, or from the web UI through the server, whose own group it would
# otherwise inherit. addon-cgroup.sh makes the leaf, and says what it falls
# back to on an older image or on a kernel without cgroup2.
#
# The leaf's memory.max is "max", no limit of its own. That is what the gateway
# had when every add-on shared addons/ directly: it is still throttled at
# the group's memory.high and killed at the group's memory.max (96M and 128M
# on the reference board, from the device description). The gateway peaks at
# 22 to 28 MB resident. A limit of its own comes with the add-on manifest,
# once it is measured alone.
ADDONS_CGROUP=${ADDONS_CGROUP:-/sys/fs/cgroup/addons}
ADDON_CGROUP_SH=${ADDON_CGROUP_SH:-/kvmapp/system/addon-cgroup.sh}
if [ -r "$ADDON_CGROUP_SH" ]; then
  # shellcheck source=../addon-cgroup.sh
  . "$ADDON_CGROUP_SH"
  addon_cgroup_join picoclaw max
fi
# --- end cgroup ---

case "$1" in
  start)
    start_service
    ;;

  stop)
    stop_service
    echo "OK"
    ;;

  onboard)
    onboard_service
    ;;

  restart)
    stop_service
    start_service
    echo "OK"
    ;;

  *)
    echo "Usage: $0 {start|stop|onboard|restart}"
    exit 1
    ;;
esac
