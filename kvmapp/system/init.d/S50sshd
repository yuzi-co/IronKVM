#!/bin/sh
#
# sshd        Starts sshd.
#

# Ensure required binaries exist
[ -x /usr/bin/ssh-keygen ] || exit 0
[ -x /usr/sbin/sshd ] || exit 1

PIDFILE="/var/run/sshd.pid"

# Settings > SSH > Keys only. The flag is on /data through the /etc/kvm bind,
# so it outlives an update and a slot switch. The drop-in is on this slot's
# root filesystem, which the next image replaces, so it is written again from
# the flag at every start. The server writes the same lines when the owner
# flips the switch.
KEYS_ONLY_FLAG=/etc/kvm/ssh_keys_only
KEYS_ONLY_DROPIN=/etc/ssh/sshd_config.d/ironkvm-keys-only.conf
AUTHORIZED_KEYS=/root/.ssh/authorized_keys

# Settings > SSH > Port, kept the same way: the number in /etc/kvm/ssh_port is
# the setting, absent for 22, and the drop-in is written from it at every
# start. The server writes the same lines when the owner changes the port.
PORT_FILE=/etc/kvm/ssh_port
PORT_DROPIN=/etc/ssh/sshd_config.d/ironkvm-port.conf

umask 077

apply_keys_only() {
    # Only with a key to log in with. The server refuses to set the flag
    # without one, and this is the same guard at boot: a board whose keys file
    # went missing keeps its password login rather than locking everyone out.
    if [ -e "$KEYS_ONLY_FLAG" ] && grep -q '^[^#]' "$AUTHORIZED_KEYS" 2>/dev/null; then
        mkdir -p "${KEYS_ONLY_DROPIN%/*}"
        printf '%s\n' '# Written by IronKVM: Settings > SSH > Keys only.' \
            'PasswordAuthentication no' 'KbdInteractiveAuthentication no' > "$KEYS_ONLY_DROPIN"
        chmod 644 "$KEYS_ONLY_DROPIN"
        # An sshd that cannot parse its configuration does not start. Take the
        # drop-in back rather than leave the board without sshd.
        if ! /usr/sbin/sshd -t 2>/dev/null; then
            rm -f "$KEYS_ONLY_DROPIN"
            echo "sshd: keys-only drop-in rejected, password login stays on"
        fi
    else
        rm -f "$KEYS_ONLY_DROPIN"
    fi
}

# advertise_port points avahi's SSH services at the port sshd listens on; the
# package ships them with 22 written in. avahi-daemon started before this
# script, so it is told to read them again when one changed.
advertise_port() {
    changed=
    for f in /etc/avahi/services/ssh.service /etc/avahi/services/sftp-ssh.service; do
        [ -f "$f" ] || continue
        grep -q "<port>$1</port>" "$f" && continue
        sed -i "s|<port>[0-9]*</port>|<port>$1</port>|" "$f" && changed=1
    done
    [ -n "$changed" ] && avahi-daemon -r 2>/dev/null
    return 0
}

apply_port() {
    port=$(cat "$PORT_FILE" 2>/dev/null)
    # Digits only and no leading zero, which the shell would read as octal.
    case "$port" in
        ''|0*|*[!0-9]*) rm -f "$PORT_DROPIN"; advertise_port 22; return ;;
    esac
    if [ "$port" -gt 65535 ] || [ "$port" -eq 22 ]; then
        rm -f "$PORT_DROPIN"
        advertise_port 22
        return
    fi
    mkdir -p "${PORT_DROPIN%/*}"
    printf '%s\n' '# Written by IronKVM: Settings > SSH > Port.' "Port $port" > "$PORT_DROPIN"
    chmod 644 "$PORT_DROPIN"
    # As for keys-only: a drop-in sshd cannot parse would keep it from
    # starting, so it is taken back and sshd listens on 22.
    if ! /usr/sbin/sshd -t 2>/dev/null; then
        rm -f "$PORT_DROPIN"
        echo "sshd: port $port rejected, listening on 22"
        port=22
    fi
    advertise_port "$port"
}

startssh() {
    # Generate SSH keys if they do not exist
    [ ! -f /etc/ssh/ssh_host_rsa_key ] && /usr/bin/ssh-keygen -A

    apply_port
    apply_keys_only

        printf "Starting sshd: "
        /usr/sbin/sshd
        touch /var/lock/sshd
        echo "OK"
}

start() {
    if [ -e /etc/kvm/ssh_stop ]; then
        if [ -e /boot/start_ssh_once ]; then
            rm -f /boot/start_ssh_once
            startssh
        else
            echo "SSH does not start"
            exit 0
        fi
    else
        startssh
    fi
}

stop() {
        printf "Stopping sshd: "
        killall sshd 2>/dev/null
        rm -f /var/lock/sshd
        echo "OK"
}

restart() {
        stop
        start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    permanent_on)
        rm -f /etc/kvm/ssh_stop
        start
        ;;
    permanent_off)
        touch /etc/kvm/ssh_stop
        stop
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|permanent_on|permanent_off}"
        exit 1
esac

exit 0