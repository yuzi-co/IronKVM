#!/bin/sh
# kvmhwd Rev2.2

# --- endpoint budget ---
# The USB controller has a fixed number of endpoints, and every function takes a
# share. Overrunning it does not disable the newest function: the whole gadget
# refuses to bind, so /dev/hidg* never appear and the keyboard and both mice are
# gone. The kernel names whichever function was linked last, not the one that
# overran, so the message points at the wrong thing.
#
# Seen on 2026-08-04 with the console, the disk, the network and the speaker all
# switched on - twelve endpoints asked of eight:
#
#   configfs-gadget gadget: acm/000000000223f9a0: can't bind, err -19
#   configfs-gadget 4340000.usb: failed to start g0: -19
#
# So count first and link second. When more is enabled than fits, give up the
# lower priority function its place: nobody is present at boot to be asked, and coming up
# without a keyboard is the worst available outcome.
#
# Never delete the marker of a function that is given up. The operator's intent
# stays on disk, so switching something else off brings it back on its own.

# usb_marker exists so the tests can redirect the lookup away from /boot.
usb_marker() {
    [ -e "/boot/$1" ]
}

# usb_in_budget and usb_out_budget are how many endpoints of functions this
# controller fits, in each direction.
#
# The two directions have different limits and the inbound one runs out first.
# dwc2 prints its own count a few seconds before this script runs:
#
#   dwc2 4340000.usb: EPs: 8, dedicated fifos, 3072 entries in SPRAM
#
# That is neither budget. The controller reports both, and this is what it
# reported on 2026-08-27:
#
#   # cat /sys/kernel/debug/usb/4340000.usb/hw_params
#   num_dev_ep                    : 7
#   total_fifo_size               : 3072
#   # cat /sys/kernel/debug/usb/4340000.usb/fifo
#   RXFIFO: Size 536
#   NPTXFIFO: Size 32, Start 0x00000218
#   Periodic TXFIFOs:
#       DPTXFIFO 1: Size 768, Start 0x00000238
#       DPTXFIFO 2: Size 512, Start 0x00000538
#       DPTXFIFO 3: Size 512, Start 0x00000738
#       DPTXFIFO 4: Size 384, Start 0x00000938
#       DPTXFIFO 5: Size 128, Start 0x00000ab8
#       DPTXFIFO 6: Size 128, Start 0x00000b38
#
# Seven endpoint pairs beside ep0, and six dedicated transmit FIFOs. dwc2 runs
# in dedicated FIFO mode here, and it refuses an IN endpoint it cannot give a
# FIFO of its own to, so six is the inbound ceiling and seven is the outbound
# one. A seventh FIFO does not fit either: 536 + 32 + 768 + 512 + 512 + 384 +
# 128 + 128 is 3000 of the 3072 words the controller has.
#
# A flat budget of nine stood here before, which was the two directions added
# together and fitted to three configurations that were tried on hardware. It
# agreed with two of them by arithmetic accident. It got the console and the
# network together wrong: that pair asks for seven inbound endpoints and can
# only be given six.
#
# The wrong case is quiet. Endpoint structures are handed out at bind time and
# there are seven of those, so the gadget binds. The shortage appears later,
# when the host sets the configuration and dwc2 has no transmit FIFO left for
# the seventh IN endpoint.
#
# Built on the board on 2026-08-28, console and network with all three HID
# functions:
#
#   dwc2 4340000.usb: new device is high-speed
#   dwc2 4340000.usb: new address 6
#   dwc2 4340000.usb: dwc2_hsotg_ep_enable: No suitable fifo found
#   dwc2 4340000.usb: dwc2_hsotg_ep_enable: No suitable fifo found
#
# Only the kernel ring showed it. The UDC reported "configured", /dev/hidg0
# through /dev/hidg2 and /dev/ttyGS0 were all there, and usb0 was up. Which
# endpoint loses is whichever is enabled seventh, and in that run the HID
# endpoints kept their places while a bulk pair did not.
#
# Depth matters too, for a function this script does not build yet. Each IN
# endpoint is seated in a FIFO that holds a whole packet, and only FIFO 1 holds
# more than 512 words. A camera or a microphone at high bandwidth therefore has
# one seat and can lose it to whatever was linked first. Count endpoints here
# and read the depths above before adding either.
#
# Leave these as constants. If a future controller differs, read the two files
# above on that board and change the numbers here.
usb_in_budget() {
    echo 6
}

usb_out_budget() {
    echo 7
}

# usb_hid_in_cost and usb_hid_out_cost are what the keyboard, the relative
# mouse and the absolute pointer cost together. They charge nothing when HID is
# switched off, because those endpoints are then genuinely free and functions
# that fit would otherwise be refused.
#
# Each HID function is an interrupt IN endpoint and an interrupt OUT endpoint.
# The OUT half is easy to miss because nothing here writes to it: f_hid
# allocates it whether or not the report descriptor has output reports, and it
# was read as active on the board.
usb_hid_in_cost() {
    if usb_marker disable_hid
    then
        echo 0
    else
        echo 3
    fi
}

usb_hid_out_cost() {
    if usb_marker disable_hid
    then
        echo 0
    else
        echo 3
    fi
}

# usb_in_cost and usb_out_cost are what one optional function takes.
#
# f_acm and the two network functions each take a bulk pair and an interrupt IN
# for notifications, so two inbound and one outbound. f_mass_storage takes a
# bulk pair. The speaker is a playback stream alone, which is one isochronous
# OUT and no inbound endpoint at all, so it never competes for the scarce
# direction.
usb_in_cost() {
    case "$1" in
        console) echo 2 ;;
        network) echo 2 ;;
        disk)    echo 1 ;;
        audio)   echo 0 ;;
        *)       echo 0 ;;
    esac
}

usb_out_cost() {
    case "$1" in
        console) echo 1 ;;
        network) echo 1 ;;
        disk)    echo 1 ;;
        audio)   echo 1 ;;
        *)       echo 0 ;;
    esac
}

# usb_keep_order lists the optional functions highest priority first, which is
# the order they are offered a place.
#
# The console ranks above the disk and the network because it is the only way
# into a board whose network is gone. Audio ranks last: it is the only entry
# that costs nothing to lose.
usb_keep_order() {
    echo "console disk network audio"
}

# usb_drop_order is the same ranking read backwards. It is compared directly
# against dropOrder() in the Go table, which sorts the same functions by
# priority ascending, and a test asserts the two lists match entry for entry.
usb_drop_order() {
    echo "audio network disk console"
}

# usb_enabled prints the functions the markers ask for. usb.ncm, usb.ecm and
# usb.rndis0 are alternatives for one function, so they produce one name, not
# three.
usb_enabled() {
    set=""

    usb_marker usb.acm && set="$set console"
    { usb_marker usb.ncm || usb_marker usb.ecm || usb_marker usb.rndis0; } && set="$set network"
    usb_marker usb.disk0 && set="$set disk"
    usb_marker usb.uac && set="$set audio"

    echo $set
}

usb_used_in() {
    used=$(usb_hid_in_cost)

    for name in $1
    do
        used=$((used + $(usb_in_cost "$name")))
    done

    echo "$used"
}

usb_used_out() {
    used=$(usb_hid_out_cost)

    for name in $1
    do
        used=$((used + $(usb_out_cost "$name")))
    done

    echo "$used"
}

# usb_has answers whether a name is in a set.
usb_has() {
    case " $1 " in
        *" $2 "*) return 0 ;;
    esac

    return 1
}

# usb_resolve prints the subset of the enabled set that fits the budget.
#
# It offers each function a place in priority order and keeps the ones that
# still fit, rather than giving up the lowest priority members until the total
# comes down. The two agree on which function outranks which and disagree on
# the result: with everything enabled, giving up in order loses audio, then the
# network, and settles on console+disk at five of the six optional endpoints -
# while console+disk+audio is exactly six and keeps one function more. Offering
# places never leaves room unused, and it cannot promote a lower priority
# function over a higher one, because the higher one was offered first.
#
# It always terminates: the list is finite and each entry is considered once. A
# budget too small for anything optional simply yields an empty set.
usb_resolve() {
    enabled=$1
    in_budget=$2
    out_budget=$3

    keep=""

    for name in $(usb_keep_order)
    do
        usb_has "$enabled" "$name" || continue

        [ "$(usb_used_in "$keep $name")" -le "$in_budget" ] || continue
        [ "$(usb_used_out "$keep $name")" -le "$out_budget" ] || continue

        keep="$keep $name"
    done

    echo $keep
}

# usb_dropped prints what the resolve gave up, for the log.
usb_dropped() {
    out=""

    for name in $1
    do
        case " $2 " in
            *" $name "*) ;;
            *) out="$out $name" ;;
        esac
    done

    echo $out
}

# usb_gadget_dirs prints the configfs directory names that one optional function
# can be built as. The network has three, because this script builds ncm, ecm
# or rndis, whichever marker ranks first, and only one of them is ever linked.
#
# HID is deliberately absent. hid.GS0, hid.GS1 and hid.GS2 are gated on
# /boot/disable_hid alone and never enter the keep set, so a caller that read
# the config directory instead of this list would delete the keyboard and both
# mice from a board that is over budget for an unrelated reason.
usb_gadget_dirs() {
    case "$1" in
        console) echo "acm.GS0" ;;
        network) echo "ncm.usb0 ecm.usb0 rndis.usb0" ;;
        disk)    echo "mass_storage.disk0" ;;
        audio)   echo "uac1.usb0" ;;
        *)       echo "" ;;
    esac
}

# usb_prune_list prints the configfs directory name of every optional function
# that the budget did NOT keep. It takes the keep set as its argument.
#
# start_usb_dev only ever adds: it makes directories and links them. The gadget
# survives `stop`, which writes an empty UDC and leaves configs/c.1 exactly as
# it was, so a function linked by an earlier start stays linked when a later
# start drops it. Switching the disk off is enough to reach that state on a
# board with the console, the network and the speaker all enabled: the first
# start keeps console+disk+audio and leaves the network out, the second keeps
# console+network and leaves audio out - and the still-linked uac1.usb0 makes
# ten endpoints of nine. The gadget then refuses to bind and every /dev/hidg*
# is gone, from one switch in the web UI.
#
# This prints names. It removes nothing itself, and the names it prints are bare
# directory names, never paths. The caller removes the symlink under
# configs/c.1 and nothing else: `rmdir functions/acm.GS0` blocks forever,
# because /etc/inittab respawns a getty on /dev/ttyGS0 and the character device
# always has a holder. Recovering from that wedge needs a full teardown of the
# gadget, possibly over the same console.
usb_prune_list() {
    prune=""

    for name in $(usb_keep_order)
    do
        usb_has "$1" "$name" && continue

        for dir in $(usb_gadget_dirs "$name")
        do
            prune="$prune $dir"
        done
    done

    echo $prune
}

# usb_report writes one line per dropped function, to the console and to /data,
# which survives the reboot that a puzzled operator will try first.
#
# The /data write is guarded. This script runs early in boot, and a board where
# that mount has not appeared yet would otherwise print a redirection error over
# the message it is trying to deliver. The console line is the one that must
# always work.
usb_report() {
    for name in $1
    do
        message="usb: not enough endpoints, $name is off (needs $(usb_in_cost "$name") in, $(usb_out_cost "$name") out)"
        echo "$message"

        if [ -d /data ]
        then
            echo "$(date '+%Y-%m-%d %H:%M:%S') $message" >> /data/usb-endpoints.log 2>/dev/null
        fi
    done
}
# --- end endpoint budget ---

# --- usb network ---
# The network function is a private link between the board and the managed
# host, and nothing more. The board takes the first address of a small subnet
# and hands the second to the host over DHCP. The lease carries a subnet mask
# and no router and no DNS server, and the board forwards nothing that arrives
# on the link, so the host never reaches the LAN through the KVM.
#
# This image carries no dnsmasq binary: S80dnsmasq exits at once because
# /etc/dnsmasq.conf is absent. udhcpd is there, from busybox-extras, because
# S30wifi serves its access point with it. The link runs a second udhcpd with a
# configuration and a pid file of its own, so neither instance can stop the
# other.
#
# Every path below has a default inside the function and not at the top of the
# file, for the reason usb_record_link gives: the test suites lift function
# bodies out of this script and source them.

# usb_net_function prints which network function the markers ask for, or
# nothing. The server writes one marker. A board with more than one takes NCM
# first, then ECM, then RNDIS, which an older server wrote and the web UI no
# longer offers.
usb_net_function() {
    if usb_marker usb.ncm
    then
        echo ncm
    elif usb_marker usb.ecm
    then
        echo ecm
    elif usb_marker usb.rndis0
    then
        echo rndis
    fi
}

# usb_net_parse reads a subnet in CIDR form and prints the board address, the
# host address, the prefix length and the netmask, or fails.
#
# The prefix is /24 to /30, so the network part of the last octet is all that
# varies and the arithmetic stays inside one byte. /30 is the smallest subnet
# with two usable addresses. The network has to be private, because the host
# takes the lease as a real route and an address on the internet would shadow
# a real one. The server applies the same rules; this copy exists because the
# file can be edited by hand.
#
# An octet with a leading zero is refused. ash reads 010 as octal.
usb_net_parse() {
    case "$1" in
        */*) ;;
        *) return 1 ;;
    esac

    usb_net_prefix=${1#*/}
    case "$usb_net_prefix" in
        24|25|26|27|28|29|30) ;;
        *) return 1 ;;
    esac

    usb_net_ifs=$IFS
    IFS=.
    set -- ${1%/*}
    IFS=$usb_net_ifs

    [ $# -eq 4 ] || return 1
    for usb_net_octet in "$@"
    do
        case "$usb_net_octet" in
            ''|*[!0-9]*|0?*|????*) return 1 ;;
        esac
        [ "$usb_net_octet" -le 255 ] || return 1
    done

    if [ "$1" -eq 10 ]
    then
        :
    elif [ "$1" -eq 172 ] && [ "$2" -ge 16 ] && [ "$2" -le 31 ]
    then
        :
    elif [ "$1" -eq 192 ] && [ "$2" -eq 168 ]
    then
        :
    else
        return 1
    fi

    usb_net_size=$((1 << (32 - usb_net_prefix)))
    [ $(($4 % usb_net_size)) -eq 0 ] || return 1

    echo "$1.$2.$3.$(($4 + 1)) $1.$2.$3.$(($4 + 2)) $usb_net_prefix 255.255.255.$((256 - usb_net_size))"
}

# usb_net_subnet prints the subnet the link uses. The server writes it to
# /etc/kvm, which is on /data and survives an update of this script. A board
# with no file uses the default, and so does a board whose file this script
# cannot read, with a line on the console that says so.
usb_net_subnet() {
    file=${USB_NET_SUBNET_FILE:-/etc/kvm/usb-network.subnet}
    fallback=172.31.255.0/30

    if [ ! -r "$file" ]
    then
        echo "$fallback"
        return 0
    fi

    subnet=$(head -n 1 "$file" | tr -d ' \t\r')
    if usb_net_parse "$subnet" > /dev/null
    then
        echo "$subnet"
    else
        echo "usb: $file holds '$subnet', which is not a private /24 to /30, using $fallback" >&2
        echo "$fallback"
    fi
}

# usb_net_udhcpd_conf writes the configuration of the link's DHCP server. It
# takes the interface, the host address, the netmask and the run directory.
#
# One address and one lease: the host is the only client a USB link can have.
# There is no "option router" and no "option dns" line, and udhcpd sends
# neither unless it is told to, so the host gets no default route and keeps its
# own resolvers.
usb_net_udhcpd_conf() {
    echo "interface $1"
    echo "start $2"
    echo "end $2"
    echo "max_leases 1"
    echo "pidfile $4/udhcpd.pid"
    echo "lease_file $4/udhcpd.leases"
    echo "option subnet $3"
    echo "option lease 864000"
}

# usb_net_ifname prints the interface a network function registered, or
# nothing.
#
# The name is not always usb0. u_ether registers the net device when the
# function first binds and keeps it until the function directory is removed,
# and this script never removes one. A board that switched from NCM to ECM
# without a reboot therefore has usb0 on ncm.usb0 and usb1 on ecm.usb0. Before
# the first bind the attribute reads the template, usb%d, which names nothing.
usb_net_ifname() {
    gadget=${USB_GADGET_DIR:-/sys/kernel/config/usb_gadget/g0}

    name=$(cat "$gadget/functions/$1/ifname" 2>/dev/null)
    case "$name" in
        ''|*%*|*/*|*' '*) return 1 ;;
    esac

    echo "$name"
}

# usb_net_no_forward keeps the board from routing the host anywhere.
#
# The interface's own forwarding switch is written first, but it does not hold:
# a write to net.ipv4.ip_forward copies itself into every interface, and
# NetBird makes that write on a routing peer. So the FORWARD chain also drops
# anything in or out of a usb interface. The rules are inserted once and left
# in place, because they cost nothing while the link is off. A board without
# iptables, or a kernel without the filter table, keeps the switch alone.
usb_net_no_forward() {
    echo 0 > "/proc/sys/net/ipv4/conf/$1/forwarding" 2>/dev/null
    echo 0 > "/proc/sys/net/ipv6/conf/$1/forwarding" 2>/dev/null

    for tool in iptables ip6tables
    do
        command -v "$tool" > /dev/null 2>&1 || continue

        for side in -i -o
        do
            "$tool" -C FORWARD "$side" usb+ -j DROP 2> /dev/null \
                || "$tool" -I FORWARD "$side" usb+ -j DROP 2> /dev/null
        done
    done

    return 0
}

# usb_net_netboot prints the script that runs dnsmasq for network boot of the
# host. It is an add-on's script and lives in /kvmapp, not in /etc/init.d.
usb_net_netboot() {
    echo "${USB_NETBOOT:-/kvmapp/system/init.d/S85netboot}"
}

# usb_net_dhcp_stop stops whichever DHCP server serves the link: the udhcpd
# this script starts, and dnsmasq when network boot had it instead. Both, every
# time, because two servers on one link would both answer the host.
usb_net_dhcp_stop() {
    run=${USB_NET_RUN:-/tmp/usb-network}

    if [ -r "$run/udhcpd.pid" ]
    then
        kill "$(cat "$run/udhcpd.pid")" 2>/dev/null
        rm -f "$run/udhcpd.pid"
    fi

    netboot=$(usb_net_netboot)
    if [ -f "$netboot" ]
    then
        sh "$netboot" stop-usb > /dev/null 2>&1
    fi

    return 0
}

# usb_net_dhcp_start starts the link's DHCP server. It takes the interface,
# the host address, the netmask and the run directory.
#
# Network boot goes first: S85netboot runs dnsmasq when the server has turned
# network boot on for the link and the add-on is installed, and fails
# otherwise. Then, or when dnsmasq does not start, udhcpd serves the link as it
# always has, so the host keeps its address whatever happens to the add-on.
usb_net_dhcp_start() {
    netboot=$(usb_net_netboot)
    if [ -f "$netboot" ] && sh "$netboot" start-usb "$1" "$2" "$3" > /dev/null 2>&1
    then
        echo "usb: network boot for the host on $1, dnsmasq serves $2"
        return 0
    fi

    mkdir -p "$4"
    usb_net_udhcpd_conf "$1" "$2" "$3" "$4" > "$4/udhcpd.conf"
    : > "$4/udhcpd.leases"

    if udhcpd -S "$4/udhcpd.conf"
    then
        echo "usb: udhcpd serves $2 on $1"
    else
        echo "usb: udhcpd did not start on $1, the host has to set $2 itself"
    fi

    return 0
}

# usb_net_dhcp restarts only the link's DHCP server, for the server to switch
# between udhcpd and dnsmasq when network boot is turned on or off. It leaves
# the gadget bound, so the host keeps its keyboard and the link its address.
usb_net_dhcp() {
    run=${USB_NET_RUN:-/tmp/usb-network}

    usb_net_fn=$(usb_net_function)
    if [ -z "$usb_net_fn" ]
    then
        echo "usb: the network to the host is off, no DHCP server to restart"
        return 0
    fi

    usb_net_if=$(usb_net_ifname "$usb_net_fn.usb0")
    if [ -z "$usb_net_if" ]
    then
        echo "usb: $usb_net_fn.usb0 has no interface, no DHCP server to restart"
        return 1
    fi

    set -- $(usb_net_parse "$(usb_net_subnet)")

    usb_net_dhcp_stop
    usb_net_dhcp_start "$usb_net_if" "$2" "$4" "$run"
}

# usb_net_stop stops the link's DHCP server and takes the address off every
# network function except the one named in $1, so that two interfaces never
# hold the same subnet after a switch between NCM and ECM.
usb_net_stop() {
    usb_net_dhcp_stop

    for dir in ncm.usb0 ecm.usb0 rndis.usb0
    do
        [ "$dir" = "$1" ] && continue

        name=$(usb_net_ifname "$dir") || continue
        ip addr flush dev "$name" 2>/dev/null
    done

    return 0
}

# usb_net_start gives the network function named in $1 its address and starts
# the DHCP server on it. It runs after the gadget is bound, because u_ether
# registers the interface at bind time.
#
# A failure here costs the link and nothing else. The keyboard and the mice
# are already bound, so this reports and returns rather than stopping the boot.
usb_net_start() {
    run=${USB_NET_RUN:-/tmp/usb-network}

    usb_net_stop "$1.usb0"

    usb_net_if=$(usb_net_ifname "$1.usb0")
    if [ -z "$usb_net_if" ]
    then
        echo "usb: $1.usb0 has no interface, no network to the host"
        return 1
    fi

    set -- $(usb_net_parse "$(usb_net_subnet)")

    ip addr flush dev "$usb_net_if" 2>/dev/null
    if ! ip addr add "$1/$3" dev "$usb_net_if"
    then
        echo "usb: could not put $1/$3 on $usb_net_if, no network to the host"
        return 1
    fi
    ip link set "$usb_net_if" up

    usb_net_no_forward "$usb_net_if"

    echo "usb: network to the host on $usb_net_if, board $1/$3, host $2"
    usb_net_dhcp_start "$usb_net_if" "$2" "$4" "$run"
}
# --- end usb network ---

# usb_unbind empties the UDC and then reads it back.
#
# The write is not proof. configfs answers ENODEV when the gadget is already
# unbound, and a write that fails for any other reason leaves the controller
# name in place. The shell discards both. usb_bind is then handed a UDC that is
# already populated, its wait loop never runs, and it returns success without
# having bound anything - so an unbind that did not take was scored as a
# completed rebind.
#
# That matters most to the supervisor in server/service/hid/usb_watchdog.go.
# `restart` is the cheap rung it tries twice before escalating to stop_start,
# so two silent no-ops looked like two honest repairs that did not help.
usb_unbind() {
    udc=/sys/kernel/config/usb_gadget/g0/UDC

    echo "" > "$udc" 2>/dev/null

    if [ -n "$(cat "$udc" 2>/dev/null)" ]
    then
        echo "usb: the gadget is still bound to $(cat "$udc"), not rebinding"
        return 1
    fi

    return 0
}

# usb_bind hands the gadget to a device controller, and waits for one to exist.
#
# The single write this replaces assumed /sys/class/udc was populated by the
# time this script ran. It usually is. When dwc2 is still probing it is empty,
# the write puts nothing into UDC, and writing nothing to UDC is how a caller
# deliberately unbinds - so the gadget is built, never bound, and no error is
# reported anywhere. What an operator sees is a board with no keyboard.
#
# The retry comes from sipeed/LicheeRV-Nano-Build a3ccb527. The bound does not.
# That loop is `while true`, and this script runs from the rcS wait entry, so a
# controller that never appears would stop the boot before the network and the
# server start. Coming up unbound is recoverable from the web UI; not coming up
# is not, and the USB console that would answer instead is part of this gadget.
#
# The pause is a whole second because this image's BusyBox sleep is not built
# with fractional support, and the tests stub sleep so they do not pay it.
# usb_watch_enumeration waits for the host to accept the gadget, and rebinds it
# when the host never does.
#
# Bound to a controller is not the same as enumerated. On 2026-08-19 a board
# booted with the gadget bound, all three /dev/hidg* present and every
# descriptor correct, and no input reached the managed host at all. dmesg showed
# the host resetting the bus nine times between t=3.8s and t=5.7s and never
# issuing SET_ADDRESS. A stop_start hours later enumerated it at high speed on
# the first attempt, and every endpoint came back.
#
# Nothing reports this. `cat UDC` names a controller either way, the device
# nodes are present either way, and the server learns of it only when a write
# times out, which is after somebody has pressed a key that went nowhere.
#
# The controller does report it. /sys/class/udc/<udc>/state reads "configured"
# once the host has accepted the gadget, and something below that until then.
# Measured on the device: configured while working, "not attached" while
# unbound, configured again after a rebind.
#
# The bound is not optional. A board with nothing plugged into it never reaches
# "configured", and that is a normal board, not a fault. The window is spent per
# attempt rather than once, so a managed host that is still powering on is
# waited for instead of interrupted.
USB_ENUM_TRIES=${USB_ENUM_TRIES:-2}
USB_ENUM_WAIT=${USB_ENUM_WAIT:-5}

usb_enumerated() {
    for f in /sys/class/udc/*/state
    do
        [ -r "$f" ] || continue
        [ "$(cat "$f")" = configured ] && return 0
    done

    return 1
}

# usb_record_link appends one line per boot, so the speed the link negotiated
# survives long enough for somebody to read it.
#
# The kernel reports that speed once, at reset time, and the report does not
# last. This board writes a VPSS line to the ring buffer every second once the
# video pipeline runs, and the ring holds about forty minutes. Measured on
# 2026-08-19: forty minutes after boot the ring held no dwc2 line at all.
#
# That is why a board that comes up full-speed has been characterised several
# times and diagnosed none. The symptom is a keyboard that does nothing, the
# operator looks some hours later, and every trace of the enumeration has gone.
#
# A good boot costs one line. A boot that did not come up high-speed and
# configured also copies the dwc2 lines out of the ring, because that is the
# last moment they exist.
#
# The log is bounded and it lives on /data. A board that reboots in a loop must
# not fill the partition, and runtime state never goes on /kvmapp, which is the
# boot card.
#
# The defaults are resolved here rather than at the top of the file. The test
# suites lift function bodies out of this script and source them, so a default
# written as a top-level assignment is simply absent when they run.
usb_link_speed() {
    for f in /sys/class/udc/*/current_speed
    do
        [ -r "$f" ] && { cat "$f"; return; }
    done

    echo unknown
}

usb_link_state() {
    for f in /sys/class/udc/*/state
    do
        [ -r "$f" ] && { cat "$f"; return; }
    done

    echo unknown
}

usb_record_link() {
    log=${USB_LINK_LOG:-/data/usb-link.log}
    keep=${USB_LINK_KEEP:-200}

    # S01fs mounts /data before this script runs. A board whose data partition
    # is absent or broken must still boot, so this is a silence, not an error.
    [ -d "$(dirname "$log")" ] || return 0

    speed=$(usb_link_speed)
    state=$(usb_link_state)
    up=$(cut -d. -f1 /proc/uptime 2>/dev/null)

    {
        echo "$(date '+%Y-%m-%d %H:%M:%S') up=${up:-?}s speed=$speed state=$state rebinds=${1:-0}"

        # Only when something was wrong. The dwc2 lines are the evidence, and
        # copying them every boot would put the whole ring on the card.
        if [ "$speed" != high-speed ] || [ "$state" != configured ]
        then
            dmesg | grep dwc2 | sed 's/^/    /'
        fi
    } >> "$log" 2>/dev/null

    if [ "$(wc -l < "$log" 2>/dev/null || echo 0)" -gt "$keep" ]
    then
        tail -n "$keep" "$log" > "$log.new" 2>/dev/null && mv "$log.new" "$log"
    fi

    return 0
}

# usb_watch_enumeration records whatever the watch settled on, and returns what
# the watch decided. Every exit of usb_watch_link is a boot worth a line: the
# one that worked, the one that needed a rebind, and the one that never
# enumerated at all.
usb_watch_enumeration() {
    usb_watch_link
    watched=$?

    usb_record_link "$rebinds"

    return "$watched"
}

# usb_link_ok answers whether the host took the gadget AND at a speed that can
# carry it. Those are two separate failures with one symptom.
#
# Reaching "configured" is not enough. A board that comes up full-speed is
# addressed, has its descriptors read and its configuration selected, and still
# cannot work: the periodic bandwidth in a full-speed frame does not hold three
# HID interrupt endpoints alongside the console, the disk and the speaker. The
# host schedules what fits and silently stops polling the rest. On 2026-08-19
# that left a working absolute mouse and a dead keyboard.
#
# The first version of this watch waited for "configured" alone. It looked
# directly at that board and reported it healthy.
usb_link_ok() {
    usb_enumerated || return 1

    [ "$(usb_link_speed)" = high-speed ]
}

# usb_link_fault names which of the two happened, so the console line is worth
# reading. "Not enumerated" and "enumerated uselessly" want different answers
# from whoever finds the board.
usb_link_fault() {
    if usb_enumerated
    then
        echo "the host enumerated the gadget at $(usb_link_speed)"
    else
        echo "the host has not enumerated the gadget"
    fi
}

usb_watch_link() {
    rebinds=0

    while :
    do
        waited=0
        while [ "$waited" -lt "$USB_ENUM_WAIT" ]
        do
            usb_link_ok && return 0
            sleep 1
            waited=$((waited + 1))
        done

        # The bound matters more here than it did. A host that really is
        # full-speed only is a board working as well as it can, and it must
        # settle rather than rebind for the rest of its uptime.
        if [ "$rebinds" -ge "$USB_ENUM_TRIES" ]
        then
            echo "usb: $(usb_link_fault) after $rebinds rebind(s), leaving it bound"
            return 1
        fi

        rebinds=$((rebinds + 1))
        echo "usb: $(usb_link_fault), rebinding ($rebinds/$USB_ENUM_TRIES)"

        usb_unbind || return 1
        sleep 1
        usb_bind || return 1
    done
}

usb_bind() {
    tries=${USB_BIND_TRIES:-10}
    udc=/sys/kernel/config/usb_gadget/g0/UDC
    n=0

    while [ -z "$(cat "$udc" 2>/dev/null)" ]
    do
        if [ "$n" -ge "$tries" ]
        then
            echo "usb: no device controller after $tries tries, gadget left unbound"
            return 1
        fi

        [ "$n" -gt 0 ] && sleep 1
        n=$((n + 1))

        ls /sys/class/udc/ | cat > "$udc" 2>/dev/null
    done

    return 0
}

# usb_devinfo reads one key from the device description.
#
# Two facts about the USB port live there now: USB_ROLE_SWITCH says how the port
# changes role, and USB_PHY_DRIVER with USB_PHY_DEVICE name what restart_phy
# unbinds and binds again. A second board states both differently, and until
# this change they were spelled out in this file.
#
# The reader is found in two steps, the same two S01fs and S01zram take. An
# image built by ironkvm-dist installs it at /usr/bin/ironkvm-deviceinfo, so the
# bare name resolves through PATH. A board that runs Sipeed's firmware installs
# the application tarball instead, and that install.sh comes from the official
# base tarball, which the fork cannot change: nothing puts the reader on PATH
# there. So the second step is the copy the tarball carries.
#
# Nothing here fails when the reader or the key is missing. The callers treat an
# empty answer as "this board says nothing", and what they do then is what this
# script did before the keys existed.
usb_devinfo() {
    _reader=${DEVINFO:-ironkvm-deviceinfo}
    if [ "$_reader" = ironkvm-deviceinfo ] && ! command -v "$_reader" > /dev/null 2>&1
    then
        _reader=${DEVINFO_TARBALL:-/kvmapp/system/ironkvm-deviceinfo}
    fi
    "$_reader" get "$1" 2> /dev/null
}

# set_otg_role puts the port in a role, through the device's helper where there
# is one, and through /proc/cviusb/otg_role where there is not.
#
# The two paths are the shape S15kvmhwd uses, and for the same reason. An image
# built by ironkvm-dist installs /usr/lib/ironkvm/hw.d/usb-role, which carries
# the whole read-back loop below and the account of why it is there. A board on
# Sipeed's firmware has no such file: it has this application tarball and
# nothing else, and it has to keep working exactly as it does today. So the old
# code stays here, and it is what runs when the helper is absent.
#
# USB_ROLE_SWITCH=none is the third answer. It says the port is wired for one
# role and there is nothing to switch, so the right action is no action. A
# description that says nothing at all, or a reader that cannot be found, falls
# through to the old code rather than to silence, because a board whose
# description went missing must still come up with a gadget.
#
# What follows is the account of the read-back. The helper carries a copy, and
# the two have to stay in step: devices/sipeed-nanokvm/test-usb-role.sh in
# ironkvm-dist holds the failure line of one against the other.
#
# The write is not a note of intent. It reaches dwc2_set_hw_id(), which pokes
# the SoC register at 0x03000048 and flips the hardware ID pin, and the
# controller answers asynchronously through a workqueue. What the file reads
# back afterwards is cviusb.id_override, and platform.c initialises that to 0,
# which is "host".
#
# The write can therefore report success while the controller settles back on
# the other side of it. RobbyV2 measured that on this SoC after a camera
# toggle: the gadget bound to 4340000.usb, every function still linked,
# /proc/cviusb/otg_role reading "host", the UDC at "not attached", and dwc2
# logging "Mode Mismatch Interrupt: currently in Host mode". A gadget bound in
# host mode never enumerates, so HID, the gadget NIC and the disk are all dead
# at once while configfs reports a healthy gadget. Writing "device" once more
# brought it back with no reboot.
#
# Nothing here read the file back, so a recovery that left the board in host
# mode was scored as a successful recovery. This does not prove the controller
# reached the mode - that is what usb_link_ok's two-part test is for - it proves
# only that the setting stuck, which is the part that was observed drifting.
#
# The pause is a whole second for the same reason usb_bind's is: this image's
# BusyBox sleep is not built with fractional support.
set_otg_role() {
    role=$1

    if [ "$(usb_devinfo USB_ROLE_SWITCH)" = none ]
    then
        return 0
    fi

    hook=${USB_ROLE_HOOK:-/usr/lib/ironkvm/hw.d/usb-role}
    if [ -x "$hook" ]
    then
        "$hook" "$role"
        return $?
    fi

    tries=${USB_OTG_ROLE_TRIES:-3}
    n=0

    while [ "$n" -lt "$tries" ]
    do
        [ "$n" -gt 0 ] && sleep 1
        n=$((n + 1))

        echo "$role" > /proc/cviusb/otg_role 2>/dev/null

        if [ "$(cat /proc/cviusb/otg_role 2>/dev/null)" = "$role" ]
        then
            [ "$n" -gt 1 ] && echo "usb: otg role $role took on write $n"
            return 0
        fi
    done

    echo "usb: otg role stayed at '$(cat /proc/cviusb/otg_role 2>/dev/null)' after $tries writes, wanted $role"
    return 1
}

# efuse_uid prints the chip id in the form the vendor kernel's
# /sys/class/cvi-base/base_uid has, "UID: %08x_%08x", read from the eFuse
# nvmem device instead. It is for a kernel without that file: the mainline
# kernel has no cvi-base driver, and exposes the eFuse shadow registers as
# nvmem instead: sg2002-efuse0 from nixos-nanokvm's patch 0083, or cv1800-efuse
# from ironkvm-dist's former mainline patch 0901 on older mainline kernels. Both
# keep the shadow offsets. The two words are at 0x0c and 0x10, as
# the vendor driver reads them, so the serial and the MACs built from the id
# stay what they are on the vendor kernel. Status 1 and no output when there is
# no such device either.
efuse_uid() {
    for _efuse in /sys/bus/nvmem/devices/sg2002-efuse*/nvmem \
        /sys/bus/nvmem/devices/cv1800-efuse/nvmem
    do
        [ -r "$_efuse" ] && break
    done
    [ -r "$_efuse" ] || return 1
    set -- $(od -An -tx4 -j12 -N8 "$_efuse" 2>/dev/null)
    [ $# -eq 2 ] || return 1
    printf 'UID: %s_%s\n' "$1" "$2"
}

start_usb_dev(){
    # f_hid copies the descriptors into its instance when the gadget is bound
    # and refuses every write to them afterwards, so rebuilding on top of a
    # bound gadget rewrites nothing and still reports success. stop_start gets
    # here through start_usb_host, whose unbind can now fail, and the case arm
    # cannot test that without also treating a failed otg role write as fatal.
    # Refuse at the point the invariant is actually needed.
    if [ -n "$(cat /sys/kernel/config/usb_gadget/g0/UDC 2>/dev/null)" ]
    then
        echo "usb: the gadget is still bound, not rebuilding it"
        return 1
    fi

    . /etc/profile
    echo "usb mode: device"
    cd /sys/kernel/config/usb_gadget

    mkdir g0
    cd g0

    # bcdDevice is what the server reads to report which HID mode the board is
    # in, so it has to be written rather than left at its default. The default
    # happens to be the value wanted here: the kernel derives it from its own
    # version, and 5.10 gives 0x0510. That is a coincidence, and it stops being
    # true the moment a mode switch runs S03usbhid, which writes 0x0623 and
    # leaves it there for whatever starts next.
    echo 0x0200 > bcdUSB
    echo 0x0510 > bcdDevice

    # echo 0x3346 > idVendor
    # echo 0x1009 > idProduct
    if [ -e /boot/usb.vid ]
    then
        cat /boot/usb.vid > idVendor
    else
        echo 0x3346 > idVendor
    fi
    if [ -e /boot/usb.pid ]
    then
        cat /boot/usb.pid > idProduct
    else
        echo 0x1009 > idProduct
    fi

    echo 0xEF > bDeviceClass
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol

    mkdir strings/0x409
    # A hardware-derived serial lets a host tell two NanoKVMs apart. Mass
    # storage needs at least 12 characters, so fall back rather than hand the
    # gadget a serial the host will reject.
    serial='0123456789ABCDEF'
    if [ -f /sys/class/cvi-base/base_uid ]
    then
        uid_serial=$(awk '{print $2}' /sys/class/cvi-base/base_uid | tr -d '_')
        if [ ${#uid_serial} -ge 12 ]
        then
            serial="$uid_serial"
        fi
    elif usb_efuse_uid=$(efuse_uid)
    then
        uid_serial=$(printf '%s\n' "$usb_efuse_uid" | awk '{print $2}' | tr -d '_')
        if [ ${#uid_serial} -ge 12 ]
        then
            serial="$uid_serial"
        fi
    fi
    echo "$serial" > strings/0x409/serialnumber
    echo 'sipeed' > strings/0x409/manufacturer
    echo 'NanoKVM' > strings/0x409/product

    mkdir configs/c.1
    echo 0xE0 > configs/c.1/bmAttributes
    echo 120 > configs/c.1/MaxPower
    mkdir configs/c.1/strings/0x409
    echo "NanoKVM" >  configs/c.1/strings/0x409/configuration

    # Decide what fits before anything is linked. Everything below tests
    # usb_keep rather than the marker, so a function that lost its place is
    # simply not built - its marker is untouched and it returns on its own
    # when something else is switched off.
    usb_wanted=$(usb_enabled)
    usb_keep=$(usb_resolve "$usb_wanted" "$(usb_in_budget)" "$(usb_out_budget)")
    usb_report "$(usb_dropped "$usb_wanted" "$usb_keep")"

    # usb_kept answers whether a function survived the budget.
    usb_kept() {
        usb_has "$usb_keep" "$1"
    }

    # Everything below this point only adds, and `stop` leaves configs/c.1
    # exactly as it was, so a function linked by an earlier start would survive
    # a later start that dropped it and put the gadget back over its budget.
    # Take the stale links out before anything is linked.
    #
    # The symlink only. Never rmdir a function directory and never touch
    # anything under functions/ - see usb_prune_list for why. HID cannot appear
    # in this list, because usb_prune_list walks the optional functions alone.
    for usb_stale in $(usb_prune_list "$usb_keep")
    do
        rm -f "configs/c.1/$usb_stale"
    done

    # Deterministic gadget MACs from the chip UID so the host-side RNDIS/NCM
    # interface keeps a STABLE MAC across re-enumeration/reboot. Without this
    # the kernel assigns a random dev_addr/host_addr on every bind, so the
    # attached PC sees a brand-new network adapter (and MAC) each time.
    if [ -f /sys/class/cvi-base/base_uid ] || ! usb_efuse_uid=$(efuse_uid)
    then
        usb_uid=$(sha512sum /sys/class/cvi-base/base_uid | head -c 4)
    else
        usb_uid=$(printf '%s\n' "$usb_efuse_uid" | sha512sum | head -c 4)
    fi
    if [ -n "$usb_uid" ]
    then
        usb_dev_mac="48:da:35:6e:${usb_uid%??}:${usb_uid#??}"
        usb_host_mac="48:da:35:6d:${usb_uid%??}:${usb_uid#??}"
    fi

    # Which of the three network functions to build, if the budget kept the
    # network at all. The prune above keeps all three links whenever the
    # network is kept, so the two that were not chosen lose theirs here: a
    # board switched from NCM to ECM would otherwise carry both, and ask for two
    # more inbound endpoints than the budget allowed. The symlink only, as in
    # the prune.
    usb_net=""
    if usb_kept network
    then
        usb_net=$(usb_net_function)
    fi
    for usb_net_dir in ncm.usb0 ecm.usb0 rndis.usb0
    do
        [ "$usb_net_dir" = "$usb_net.usb0" ] || rm -f "configs/c.1/$usb_net_dir"
    done

    if [ "$usb_net" = ncm ]
    then
        mkdir functions/ncm.usb0
        [ -n "$usb_dev_mac" ]  && echo "$usb_dev_mac"  > functions/ncm.usb0/dev_addr
        [ -n "$usb_host_mac" ] && echo "$usb_host_mac" > functions/ncm.usb0/host_addr
        echo WINNCM > functions/ncm.usb0/os_desc/interface.ncm/compatible_id
        ln -s functions/ncm.usb0 configs/c.1/
    elif [ "$usb_net" = ecm ]
    then
        # ECM is the fallback for a host with no NCM driver. Linux and macOS
        # drive it with their own class driver. Windows has none, so there is
        # no Microsoft OS descriptor to offer for it.
        mkdir functions/ecm.usb0
        [ -n "$usb_dev_mac" ]  && echo "$usb_dev_mac"  > functions/ecm.usb0/dev_addr
        [ -n "$usb_host_mac" ] && echo "$usb_host_mac" > functions/ecm.usb0/host_addr
        ln -s functions/ecm.usb0 configs/c.1/
    elif [ "$usb_net" = rndis ]
    then
        mkdir functions/rndis.usb0
        [ -n "$usb_dev_mac" ]  && echo "$usb_dev_mac"  > functions/rndis.usb0/dev_addr
        [ -n "$usb_host_mac" ] && echo "$usb_host_mac" > functions/rndis.usb0/host_addr
        echo e0 > functions/rndis.usb0/class
        echo 01 > functions/rndis.usb0/subclass
        echo 03 > functions/rndis.usb0/protocol
        echo RNDIS > functions/rndis.usb0/os_desc/interface.rndis/compatible_id
        echo 5162001 > functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id
        ln -s functions/rndis.usb0 configs/c.1/
    fi

    if [ "$usb_net" = ncm ] || [ "$usb_net" = rndis ]
    then
        # Microsoft OS 2.0 Descriptor
        echo 1 > os_desc/use
        echo 0xCD > os_desc/b_vendor_code
        echo MSFT100 > os_desc/qw_sign
        ln -s configs/c.1 os_desc
    else
        # The link survives a start that drops the network, the same way the
        # function links do, and it then advertises Microsoft OS descriptors
        # for a configuration that has nothing to describe.
        rm -f os_desc/c.1
        echo 0 > os_desc/use
    fi

    # Take the HID functions out of the configuration before touching them.
    #
    # f_hid copies subclass, protocol, report_length and the report descriptor
    # into the instance when the link is made, and refuses every write to those
    # attributes with EBUSY for as long as the link exists. A start that runs
    # against a gadget the other mode built would therefore write nothing, see
    # no error worth acting on, and rebind carrying the other mode's
    # descriptors.
    #
    # The symlink only. The function directory stays: see usb_prune_list.
    #
    # This runs whether or not HID is wanted, so that /boot/disable_hid also
    # removes links an earlier start made.
    rm -f configs/c.1/hid.GS0 configs/c.1/hid.GS1 configs/c.1/hid.GS2

    if [ ! -e /boot/disable_hid ]
    then
        # keyboard: boot protocol, so firmware that only speaks boot HID
        # accepts it. Declaring boot support does not remove the report
        # descriptor, so a host that prefers report protocol is unaffected.
        mkdir functions/hid.GS0
        echo 1 > functions/hid.GS0/subclass
        # wakeup_on_write is a vendor f_hid option. A kernel without it has
        # no such attribute, configfs refuses to create one, and the write
        # would only print an error, so it is made where the attribute exists
        # and reported once where it does not.
        if [ -e /boot/usb.wakeup ] && [ -e functions/hid.GS0/wakeup_on_write ]
        then
            echo 1 > functions/hid.GS0/wakeup_on_write
        elif [ -e /boot/usb.wakeup ]
        then
            echo "usb: /boot/usb.wakeup is set, and this kernel's f_hid has no wakeup_on_write"
        fi
        echo 1 > functions/hid.GS0/protocol
        echo 8 > functions/hid.GS0/report_length
        echo -ne \\x05\\x01\\x09\\x06\\xa1\\x01\\x05\\x07\\x19\\xe0\\x29\\xe7\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\x95\\x01\\x75\\x08\\x81\\x03\\x95\\x05\\x75\\x01\\x05\\x08\\x19\\x01\\x29\\x05\\x91\\x02\\x95\\x01\\x75\\x03\\x91\\x03\\x95\\x06\\x75\\x08\\x15\\x00\\x25\\xE7\\x05\\x07\\x19\\x00\\x29\\xE7\\x81\\x00\\xc0 > functions/hid.GS0/report_desc
        ln -s functions/hid.GS0 configs/c.1

        # relative mouse: boot protocol, same reasoning as the keyboard
        mkdir functions/hid.GS1
        echo 1 > functions/hid.GS1/subclass
        if [ -e /boot/usb.wakeup ] && [ -e functions/hid.GS1/wakeup_on_write ]
        then
            echo 1 > functions/hid.GS1/wakeup_on_write
        fi
        echo 2 > functions/hid.GS1/protocol
        echo 5 > functions/hid.GS1/report_length
        echo -ne \\x5\\x1\\x9\\x2\\xa1\\x1\\x9\\x1\\xa1\\x0\\x5\\x9\\x19\\x1\\x29\\x3\\x15\\x0\\x25\\x1\\x95\\x3\\x75\\x1\\x81\\x2\\x95\\x1\\x75\\x5\\x81\\x3\\x5\\x1\\x9\\x30\\x9\\x31\\x9\\x38\\x15\\x81\\x25\\x7f\\x75\\x8\\x95\\x3\\x81\\x6\\x5\\xc\\xa\\x38\\x2\\x15\\x81\\x25\\x7f\\x75\\x8\\x95\\x1\\x81\\x6\\xc0\\xc0 > functions/hid.GS1/report_desc
        ln -s functions/hid.GS1 configs/c.1

        # absolute pointer: never boot. The boot mouse protocol has no
        # absolute coordinates, so claiming it here described a device this
        # is not, and a host taking that at face value got nonsense.
        mkdir functions/hid.GS2
        if [ -e /boot/usb.wakeup ] && [ -e functions/hid.GS2/wakeup_on_write ]
        then
            echo 1 > functions/hid.GS2/wakeup_on_write
        fi
        echo 2 > functions/hid.GS2/protocol
        # /boot/usb.extkeys adds the Consumer Control and System Control keys
        # (media, volume, sleep, power) to this interface under report IDs 2
        # and 3, rather than taking an endpoint of their own. The pointer
        # becomes ID 1, and report_length is one ID byte plus its six. The
        # keyboard and the relative mouse never carry IDs, because a firmware
        # reading them in boot protocol expects none.
        #
        # It is opt-in because a server that predates the IDs sends the
        # pointer without one, and the host then drops or misreads it. A
        # rolled-back deploy or an upstream update leaves exactly that. The
        # server reads report_length to decide whether to send an ID.
        #
        # /boot/usb.touch adds a two-finger touch screen under report ID 4,
        # on top of the same IDs, so the pointer's reports stay byte for byte
        # what /boot/usb.extkeys gives. A touch report carries one contact and
        # fits in the same seven bytes; two fingers are two reports, which is
        # the hybrid mode Windows and Linux both read. ID 5 is the Contact
        # Count Maximum feature and ID 6 the Windows certification blob. Linux
        # needs the blob too: without it hid-multitouch uses its default class,
        # which ignores the mouse collection on the same interface.
        if [ -e /boot/usb.touch ]
        then
            echo 7 > functions/hid.GS2/report_length
            echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x85\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x05\\x15\\x00\\x25\\x01\\x95\\x05\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x03\\x81\\x01\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x35\\x00\\x45\\x00\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0\\x05\\x0c\\x09\\x01\\xa1\\x01\\x85\\x02\\x15\\x00\\x26\\xff\\x03\\x19\\x00\\x2a\\xff\\x03\\x75\\x10\\x95\\x01\\x81\\x00\\xc0\\x05\\x01\\x09\\x80\\xa1\\x01\\x85\\x03\\x15\\x00\\x26\\xff\\x00\\x19\\x00\\x29\\xff\\x75\\x08\\x95\\x01\\x81\\x00\\xc0\\x05\\x0d\\x09\\x04\\xa1\\x01\\x85\\x04\\x09\\x22\\xa1\\x02\\x09\\x42\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x01\\x81\\x02\\x09\\x51\\x25\\x7f\\x75\\x07\\x95\\x01\\x81\\x02\\x05\\x01\\x09\\x30\\x09\\x31\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x35\\x00\\x45\\x00\\xc0\\x05\\x0d\\x09\\x54\\x25\\x02\\x75\\x08\\x95\\x01\\x81\\x02\\x85\\x05\\x09\\x55\\x25\\x02\\x75\\x08\\x95\\x01\\xb1\\x02\\x06\\x00\\xff\\x85\\x06\\x09\\xc5\\x15\\x00\\x26\\xff\\x00\\x75\\x08\\x96\\x00\\x01\\xb1\\x02\\xc0 > functions/hid.GS2/report_desc
        elif [ -e /boot/usb.extkeys ]
        then
            echo 7 > functions/hid.GS2/report_length
            echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x85\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x05\\x15\\x00\\x25\\x01\\x95\\x05\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x03\\x81\\x01\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x35\\x00\\x45\\x00\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0\\x05\\x0c\\x09\\x01\\xa1\\x01\\x85\\x02\\x15\\x00\\x26\\xff\\x03\\x19\\x00\\x2a\\xff\\x03\\x75\\x10\\x95\\x01\\x81\\x00\\xc0\\x05\\x01\\x09\\x80\\xa1\\x01\\x85\\x03\\x15\\x00\\x26\\xff\\x00\\x19\\x00\\x29\\xff\\x75\\x08\\x95\\x01\\x81\\x00\\xc0 > functions/hid.GS2/report_desc
        else
            echo 6 > functions/hid.GS2/report_length
            echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x05\\x15\\x00\\x25\\x01\\x95\\x05\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x03\\x81\\x01\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x35\\x00\\x45\\x00\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0 > functions/hid.GS2/report_desc
        fi
        ln -s functions/hid.GS2 configs/c.1
    fi

    if usb_kept disk
    then
            mkdir functions/mass_storage.disk0
            # f_mass_storage creates a LUN only while the function is not
            # linked into a config: the link holds a reference, and
            # fsg_lun_make returns EBUSY. stop_start keeps the function and its
            # link, so unlink first and link last, as the uac1 block does.
            # rm -f removes the link alone.
            rm -f configs/c.1/mass_storage.disk0
            [ -d functions/mass_storage.disk0/lun.1 ] || mkdir functions/mass_storage.disk0/lun.1

            # lun.0 is always a disk. An older server switched it into a
            # CD-ROM, and the function outlives stop_start, so a stale one is
            # emptied and turned back. cdrom and ro change only while no medium
            # is present.
            if [ "$(cat functions/mass_storage.disk0/lun.0/cdrom 2>/dev/null)" = 1 ]
            then
                    echo > functions/mass_storage.disk0/lun.0/file
                    echo 0 > functions/mass_storage.disk0/lun.0/ro
                    echo 0 > functions/mass_storage.disk0/lun.0/cdrom
            fi
            echo 1 > functions/mass_storage.disk0/lun.0/removable
            if [ -e /boot/usb.disk0.ro ]
            then
                    echo 1 > functions/mass_storage.disk0/lun.0/ro
                    echo 0 > functions/mass_storage.disk0/lun.0/cdrom
            fi
            echo "NanoKVM USB Mass Storage0520" > functions/mass_storage.disk0/lun.0/inquiry_string
            disk=$(cat /boot/usb.disk0)
            if [ -n "${disk}" ]
            then
                    cat /boot/usb.disk0 > functions/mass_storage.disk0/lun.0/file
            fi
            # With usb.disk0 empty, leave lun.0/file unset so the gadget
            # reports "no media" (removable=1) and a BIOS moves on to the next
            # boot device. This used to point at /dev/mmcblk0p3, handing the
            # target machine our raw eMMC partition -- which has no MBR, so
            # Legacy BIOS reads no 0x55AA signature and hangs in a HLT loop.

            # A second LUN, fixed as a CD-ROM, so an install ISO and a disk
            # image can be attached together. Neither LUN changes type after
            # this, so a media change is a write to its file and never needs
            # a UDC rebind. Left without a file, it reports no medium.
            echo 1 > functions/mass_storage.disk0/lun.1/removable
            echo 1 > functions/mass_storage.disk0/lun.1/cdrom
            echo 1 > functions/mass_storage.disk0/lun.1/ro
            echo "NanoKVM USB CD/DVD-ROM  0520" > functions/mass_storage.disk0/lun.1/inquiry_string

            # Linked at the same point in the function order as before, so the
            # interface numbering is unchanged.
            ln -s functions/mass_storage.disk0 configs/c.1/
    fi

    # A serial console for the managed host, off unless /boot/usb.acm exists.
    #
    # This board has no recovery that does not need a person: there is no serial
    # console on the SoC, the Cube case does not bring out the User Key, and the
    # initramfs mass-storage mode needs a working shell - which is the thing
    # that has failed. An ACM function closes most of that gap over the USB
    # cable that is already connected.
    #
    # Everything else is present already. The kernel has CONFIG_USB_F_ACM and
    # CONFIG_USB_CONFIGFS_ACM, /etc/inittab respawns a getty on ttyGS0, and
    # /etc/ttyGS0_handler.sh runs login. Without this function /dev/ttyGS0 never
    # appears and that getty respawns against nothing.
    #
    # It stays off by default because it is a trade, not a free win: whoever
    # controls the managed machine gets a login prompt on the KVM. That is worth
    # having only on a board whose root password is not the default one.
    #
    # Add it last. configfs numbers interfaces in link order, so a function
    # inserted ahead of the HID ones renumbers the keyboard and the mice under a
    # host that is already bound to them.
    if usb_kept console
    then
        mkdir functions/acm.GS0
        ln -s functions/acm.GS0 configs/c.1
    fi

    # A USB sound card for the managed host, off unless /boot/usb.uac exists.
    # The host has to select it as its output device; nothing here can do that.
    #
    # Add it last: configfs numbers USB interfaces in the order functions are
    # linked into the config. A function inserted ahead of the HID ones would
    # renumber the keyboard and the mice under a host that is already bound to
    # them.
    if usb_kept audio
    then
        mkdir functions/uac1.usb0

        # Playback off: we only ever read what the host plays. Left at the
        # kernel default both directions are enabled, so the host also gains a
        # USB microphone - and Windows and most Linux desktops move the default
        # INPUT to a new USB audio device just as readily as the output. Turning
        # on a speaker would then quietly take over the microphone on the
        # managed machine. It also saves an isochronous endpoint on a gadget
        # that already carries three HID functions.
        #
        # f_uac1 gates its IN endpoint on p_chmask, so zero removes it. If the
        # attribute is absent on this kernel the write fails and the gadget is
        # built the old way, which is why this does not abort the script.

        # How many isochronous requests u_audio keeps in flight. The kernel
        # default on this board is 3, read from the attribute itself.
        #
        # It is not only a latency setting. If a service interval passes and
        # the host delivered no transfer, the request still completes, and
        # u_audio copies that request's buffer into the ALSA ring a second
        # time. The capture then contains the audio from req_number
        # milliseconds earlier again, and the join is audible.
        #
        # RobbyV2/NanoKVM measured this against a Windows host playing a
        # 1025 Hz tone: at 4 requests, one millisecond in 5.6 was a
        # byte-identical repeat of the millisecond 4 ms before it and 60% of
        # block boundaries were discontinuous; at 8, one in 46 and 26%. That
        # measurement is not repeated here.
        #
        # The cost is buffer alone. At 48 kHz, stereo, 16-bit, a request holds
        # one millisecond, which is 192 bytes, so this asks for 1536 bytes
        # instead of 576.
        #
        # Unlink before writing, and only then link. configfs refuses both
        # attributes while a config holds the function:
        #
        #   # echo 8 > .../functions/uac1.usb0/req_number
        #   sh: write error: Resource busy
        #
        # Neither the directory nor the symlink goes away on a stop_start, so
        # on every rebuild after the first the writes above land on a function
        # the config still holds. They are redirected to /dev/null, so they
        # fail silently and the gadget comes back carrying whatever the first
        # boot wrote. Measured: a stop_start with this block writing 8 left
        # req_number at the kernel default of 3.
        #
        # rm -f on the config entry is the same operation the endpoint prune
        # already performs, and it removes the symlink alone. The function
        # directory stays, because rmdir on it blocks forever.
        rm -f configs/c.1/uac1.usb0
        echo 0 > functions/uac1.usb0/p_chmask 2>/dev/null
        echo 8 > functions/uac1.usb0/req_number 2>/dev/null

        # Linked last, so the interface numbering above is unchanged.
        ln -s functions/uac1.usb0 configs/c.1
    fi

    usb_bind

    # After the bind, because that is when u_ether registers the interface. A
    # start that dropped the network still stops the DHCP server and clears
    # the address an earlier start put on the link. Before the role call,
    # because start_usb_dev has to end with it: its status is what stop_start
    # reports to the supervisor.
    if [ -n "$usb_net" ]
    then
        usb_net_start "$usb_net"
    else
        usb_net_stop ""
    fi

    set_otg_role device
}

start_usb_host(){
    usb_unbind || return 1
    usb_net_stop ""
    set_otg_role host
}

restart_usb_dev(){
    usb_unbind || return 1
    sleep 1
    usb_bind || return 1
    echo "USB Restart OK!"
}

# restart_phy takes the controller away from its driver and gives it back.
#
# This is the last rung the supervisor in server/service/hid/usb_watchdog.go
# climbs to, and it is the heaviest thing short of a reboot: the driver releases
# the controller, the gadget goes with it, and both are built again.
#
# Which controller and which driver is a fact about the board, so it comes from
# the device description. Neither key has a default. A board that declares one
# and not the other has said nothing usable, and building the path from an empty
# value writes the device name into /sys/bus/platform/drivers//unbind, which is
# a write to a file that is not the one meant. So this says the board cannot do
# it and returns 0: the caller asked for a repair this board does not have, and
# that is not a failure of the caller.
restart_phy() {
    driver=$(usb_devinfo USB_PHY_DRIVER)
    device=$(usb_devinfo USB_PHY_DEVICE)

    if [ -z "$driver" ] || [ -z "$device" ]
    then
        echo "usb: this board has no PHY restart"
        return 0
    fi

    echo "$device" > "/sys/bus/platform/drivers/$driver/unbind"
    sleep 1
    echo "$device" > "/sys/bus/platform/drivers/$driver/bind"
    start_usb_host
    start_usb_dev
}

# HID-only mode. The web UI chooses it by copying S03usbhid over this file, and
# this file is on the root slot, so the next image put the normal script back and
# the board came up in normal mode. The server also records the choice in
# /etc/kvm/hid_only, which is on /data, and while it exists every action goes to
# S03usbhid, which is the script that mode has always run. The usb watchdog's
# restart and stop_start come through here too, so they rebuild the same gadget.
#
# S03USBDEV_DELEGATED stops a second hand-over if S03usbhid ever becomes this
# script. The paths are variables so tools/usbdev/test-hid-only-mode.sh can drive
# this with a stub. On the device nothing sets them.
HID_ONLY_FILE=${HID_ONLY_FILE:-/etc/kvm/hid_only}
HID_ONLY_SCRIPT=${HID_ONLY_SCRIPT:-/kvmapp/system/init.d/S03usbhid}
if [ -e "$HID_ONLY_FILE" ] && [ -z "${S03USBDEV_DELEGATED:-}" ]; then
    if [ -f "$HID_ONLY_SCRIPT" ]; then
        S03USBDEV_DELEGATED=1 exec sh "$HID_ONLY_SCRIPT" "$@"
    fi
    echo "usb: $HID_ONLY_FILE asks for HID-only mode and there is no $HID_ONLY_SCRIPT, staying normal"
fi

case "$1" in
  start)
    start_usb_dev

    # Backgrounded on purpose. rcS waits on this script, and the watch spends
    # its whole budget on a board that has no host attached, which is a board
    # that is working. Nothing after this point in the boot depends on the
    # gadget being enumerated.
    usb_watch_enumeration &
  ;;
  restart)
    restart_usb_dev
  ;;
  stop)
    start_usb_host
  ;;
  stop_start)
    start_usb_host
    start_usb_dev
  ;;
   restart_phy)
    restart_phy
  ;;
  dhcp)
    usb_net_dhcp
  ;;
esac
