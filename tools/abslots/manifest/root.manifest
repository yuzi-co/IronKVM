# The full NanoKVM root: the official base, the official application, and the
# fork delta. Three declared layers and nothing copied from a running board.
#
# Paths on the left are relative to the payload tree the builder is given.
# Paths on the right are absolute inside the image.
#
# The add and remove lists were discovered, not remembered: the running fork
# slot was compared against the official v1.4.3 rootfs file by file, and every
# fork script on the board turned out to match this repository byte for byte.

# ---------------------------------------------------------------- application
#
# Layer one is the official 2.5.0 release tarball, unpacked into
# payload/official-kvmapp/. The base's own /kvmapp is 2.4.3, so this is an
# upgrade and not a re-copy. Trailing slashes on both sides merge rather than
# replace.
#
# Layer two is the fork's own kvmapp on top. The order is what makes an image
# describable: everything in layer one is published and checksummed by Sipeed,
# and everything this fork changes is layer two and nothing else.
add     official-kvmapp/                          /kvmapp/
add     kvmapp/                                   /kvmapp/

# The stripped server build. 17209304 bytes against 24279504, because the
# binary runs from tmpfs and every debug byte is pinned RAM on a 166MB board.
add     server/NanoKVM-Server                     /kvmapp/server/NanoKVM-Server 0755

# The two native libraries the fork builds. Everything else in server/dl_lib is
# Sipeed's and arrives with official-kvmapp above: of the 14 that
# kvmapp/server/dl_lib carries, only these two differ from the official 2.5.0
# release, and the other 12 are byte-identical to it.
#
# They are named from server/dl_lib, which git tracks, and NOT from
# kvmapp/server/dl_lib, which .gitignore excludes. Taking them from the ignored
# directory made the encoder fix depend on one workstation's working tree: a
# fresh clone has that directory empty, so the image would keep the official
# libkvm.so, the H.264 encoder would strand its carveout again, and the build
# would report success either way.
add     server/dl_lib/libkvm.so                   /kvmapp/server/dl_lib/libkvm.so     0755
add     server/dl_lib/libkvm_mmf.so               /kvmapp/server/dl_lib/libkvm_mmf.so 0755

# The fork's web UI, built with `pnpm build` in web/. This line was missing
# from the first root A, and the image therefore paired the fork's server with
# Sipeed's official 2.5.0 UI. The two disagree about the API:
# /api/vm/device/virtual returns {enabled, active, cost} per device here and a
# plain boolean upstream. An object is truthy in JavaScript, so the official UI
# drew the virtual disk and the virtual network as permanently ON and read
# every click to turn them off as a request to turn them on.
#
# NO TRAILING SLASH, deliberately. A merge would leave the official bundle's
# hashed asset filenames beside the fork's, because two builds never collide on
# those names. This replaces the directory instead. It must also stay below the
# official-kvmapp merge above, which is what puts the official web there.
#
# web/dist is a build artefact and .gitignore excludes it, so the payload
# carries a build rather than a checkout. build-image.sh gates on a string only
# this UI has.
add     web/dist                                  /kvmapp/server/web

# --------------------------------------------------------------- init scripts
#
# /etc/init.d is what boots. /kvmapp/system/init.d is the install package's own
# copy and is written by the layer above. Both exist on a real device, and a
# change that lands in only one of them does not run.

# Modified by the fork. Each of these differs from the official base.
add     kvmapp/system/init.d/S01fs                /etc/init.d/S01fs            0755
add     kvmapp/system/init.d/S03usbdev            /etc/init.d/S03usbdev        0755
add     kvmapp/system/init.d/S30eth               /etc/init.d/S30eth           0755
add     kvmapp/system/init.d/S95nanokvm           /etc/init.d/S95nanokvm       0755

# Added by the fork. None of these exist in the official base.
add     kvmapp/system/init.d/S01zram              /etc/init.d/S01zram          0755
add     kvmapp/system/init.d/S99vidiag            /etc/init.d/S99vidiag        0755
add     tools/oled/S97oled-nudge                  /etc/init.d/S97oled-nudge    0755
add     tools/service/S98supervise                /etc/init.d/S98supervise     0755

# The watchdog goes in the manifest so "it was not installed" cannot happen
# again. On 2026-08-15 it was missing from the failing slot, which is half of
# why the card had to come out.
add     tools/abslots/device/S00awatchdog         /etc/init.d/S00awatchdog     0755

# Identity lives on /data and is bound over /etc/kvm, so a slot switch keeps
# the password and the certificates and no image ever carries them.
add     tools/abslots/device/S02identity          /etc/init.d/S02identity      0755

# The instrumented rcS. A boot that completes with no listeners leaves no
# evidence otherwise, and that is exactly the failure this whole design is
# about. It is what turned a silent failure into two named faults.
add     tools/abslots/device/rcS                  /etc/init.d/rcS              0755

# The operator tool, in every root, because the slot you are on is the one you
# need it from.
add     tools/abslots/device/slot                 /usr/bin/slot                0755

# -------------------------------------------------------------------- removes
#
# cp adds and overwrites and never deletes, so anything the base has and the
# fork does not survives unless it is named here.

# Present in the official v1.4.3 rootfs at 0 bytes. S50sshd reads it and exits
# 0 having started nothing, which is a board with no ssh and a script that
# reported success. This line is load-bearing, not defensive.
remove  /etc/kvm/ssh_stop

# S25wifimod and S30wifi are deliberately NOT removed, and an earlier revision
# of this file removed them. The reason given was that they sit between the
# network coming up and sshd starting and could wait on hardware that is not
# there. That was wrong on both counts.
#
# Neither can block. S25wifimod is four insmod lines and an exit. S30wifi runs
# wpa_supplicant with -B and udhcpc with -b inside a backgrounded subshell, and
# a grep for while, sleep, until and wait finds nothing in either script.
#
# And the fork ships a Wi-Fi provisioning page in the web UI, so removing
# S30wifi would break a feature that this repository deliberately carries. The
# running slot happens not to have them, but that is an observation about one
# board, not a decision anybody recorded.

# Operator state accumulated on a running board. 132 MB of it on the slot this
# was measured from, and none of it belongs in an image.
remove  /root
remove  /watchdog.log
remove  /bootlog
remove  /device_key

# --------------------------------------------------------------------- touches
#
# S01fs runs mkfs.exfat on the data partition when this marker is absent, and a
# base has no marker. Without this line the first boot after a flash reformats
# /data, which is where the identity and every kept slot image live.
touch   /etc/kvm.disk0
