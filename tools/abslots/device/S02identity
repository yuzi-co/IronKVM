#!/bin/sh
#
# Carry a board's identity across a slot switch, so that images stay generic and
# no image ever contains a device's secrets.
#
# The first A/B flash lost three things, and all three were identity that does
# not live in /etc/kvm:
#
#   /etc/shadow                 the root password reverted to the factory one.
#                               With /boot/usb.acm enabled that hands a root
#                               prompt to the managed host over USB.
#   /root/.ssh/authorized_keys  removed along with /root as "operator cruft",
#                               so key login was impossible and only the
#                               factory password worked.
#   /data itself                not mounted, because S01fs named p3 directly
#                               and p3 is root B in this layout.
#
# Two directories, deliberately siblings rather than nested. The bind source has
# to contain exactly what /etc/kvm should contain, so anything else stored
# inside it would appear inside /etc/kvm.
#
#   /data/identity                    bound over /etc/kvm
#   /data/identity-system/root-ssh    bound over /root/.ssh
#   /data/identity-system             shadow, passwd and the host keys, copied
#
# What is bound and what is copied is decided by one rule: a DIRECTORY can be
# bound, a single file cannot. passwd and every editor write by rename, and a
# rename replaces a single-file bind, so a bound /etc/shadow would come apart
# the first time the password changed, and a broken bind there is a board
# nobody can log into. A rename inside a bound DIRECTORY stays inside it, which
# is why /root/.ssh is bound and a key added later needs no further step.
#
# /etc/shadow is the one that cannot be bound and does change. The server
# writes it back through `S02identity save` as soon as a password change
# succeeds, so nothing depends on an operator remembering a command.
#
# Every path is a variable so tools/abslots/device/test-identity.sh can drive
# this against a scratch tree. On the device nothing sets them.
IDENTITY=${IDENTITY:-/data/identity}
SYSDIR=${SYSDIR:-/data/identity-system}
TARGET=${TARGET:-/etc/kvm}
ETCDIR=${ETCDIR:-/etc}
ROOTHOME=${ROOTHOME:-/root}
SSHDIR=${SSHDIR:-/etc/ssh}
ROOTSSH=${ROOTSSH:-/data/identity-system/root-ssh}

data_mounted() {
    [ -n "$DATA_MOUNTED" ] && { [ "$DATA_MOUNTED" = yes ]; return; }
    grep -q ' /data ' /proc/mounts 2>/dev/null
}

# A stored shadow is only used when it is plausibly a shadow file with a root
# entry. An empty or truncated one would lock the board out of every login it
# has, and this script runs before anybody could notice.
usable_shadow() {
    [ -s "$1" ] || return 1
    grep -q '^root:' "$1" || return 1
    return 0
}

# The ssh host key is identity, and it is the one that is easiest to forget.
# A slot switch swaps the whole root filesystem and /etc/ssh goes with it, so
# the board's fingerprint changes and every client that ever connected refuses
# it. With BatchMode=yes ssh does not even print why.
#
# Only non-empty files are copied, in both directions. sshd refuses to start on
# a zero-length host key, and a board with no sshd is what this design exists
# to prevent.
# Returns non-zero when it copied nothing, so the caller cannot announce a
# restore that did not happen. Every fault this design was written after was a
# step that reported success while doing nothing.
copy_host_keys() {
    from=$1
    to=$2
    # No test for a missing $from. An unmatched glob leaves the pattern
    # literal, [ -s ] rejects it, and copied stays 0, so one mechanism decides.
    # Two guards here made each other untestable: removing either alone changed
    # nothing, because the other still covered it.
    copied=0
    for k in "$from"/ssh_host_*; do
        [ -s "$k" ] || continue
        mkdir -p "$to"
        cp "$k" "$to/${k##*/}"
        case "$k" in
            *.pub) chmod 644 "$to/${k##*/}" ;;
            *)     chmod 600 "$to/${k##*/}" ;;
        esac
        copied=$((copied + 1))
    done
    [ "$copied" -gt 0 ]
}

start() {
    if ! data_mounted; then
        echo "S02identity: /data is not mounted, keeping the image's identity"
        return 0
    fi

    # First boot after a flash: seed from whatever the image carries, so the
    # board has a working identity now and binds a real one next time.
    if [ ! -d "$IDENTITY" ]; then
        echo "S02identity: seeding $IDENTITY from $TARGET"
        mkdir -p "$IDENTITY"
        cp -a "$TARGET/." "$IDENTITY/" 2>/dev/null
    fi

    if [ ! -d "$SYSDIR" ]; then
        echo "S02identity: seeding $SYSDIR from the running system"
        mkdir -p "$SYSDIR"
        [ -f "$ETCDIR/shadow" ] && cp -a "$ETCDIR/shadow" "$SYSDIR/shadow"
        [ -f "$ETCDIR/passwd" ] && cp -a "$ETCDIR/passwd" "$SYSDIR/passwd"
        [ -f "$ROOTHOME/.ssh/authorized_keys" ] && \
            cp -a "$ROOTHOME/.ssh/authorized_keys" "$SYSDIR/authorized_keys"
        copy_host_keys "$SSHDIR" "$SYSDIR/ssh"
        if [ -s "$ROOTHOME/.ssh/authorized_keys" ]; then
            mkdir -p "$ROOTSSH"
            cp "$ROOTHOME/.ssh/authorized_keys" "$ROOTSSH/authorized_keys"
            chmod 600 "$ROOTSSH/authorized_keys" 2>/dev/null
        fi
    fi

    if mount --bind "$IDENTITY" "$TARGET" 2>/dev/null; then
        echo "S02identity: $IDENTITY bound over $TARGET"
    else
        echo "S02identity: bind failed, keeping the image's $TARGET"
    fi

    if usable_shadow "$SYSDIR/shadow"; then
        cp "$SYSDIR/shadow" "$ETCDIR/shadow"
        chmod 600 "$ETCDIR/shadow"
        echo "S02identity: root password restored"
    elif [ -e "$SYSDIR/shadow" ]; then
        echo "S02identity: stored shadow is unusable, keeping the image's"
    fi

    if [ -f "$SYSDIR/passwd" ] && [ -s "$SYSDIR/passwd" ]; then
        cp "$SYSDIR/passwd" "$ETCDIR/passwd"
        chmod 644 "$ETCDIR/passwd"
    fi

    # /root/.ssh is a directory bind, not a copy, so a key added afterwards
    # lands on /data with no command to remember. A single-file bind would not
    # do: an editor and ssh-copy-id both write by rename, and the rename
    # replaces the bind. Renaming INSIDE a bound directory stays inside it.
    mkdir -p "$ROOTSSH"
    chmod 700 "$ROOTSSH" 2>/dev/null

    # Boards built before this change keep the key beside the shadow. Move it
    # in, or the first boot after an upgrade has no key login.
    if [ -s "$SYSDIR/authorized_keys" ] && [ ! -e "$ROOTSSH/authorized_keys" ]; then
        cp "$SYSDIR/authorized_keys" "$ROOTSSH/authorized_keys"
        chmod 600 "$ROOTSSH/authorized_keys" 2>/dev/null
        echo "S02identity: migrated authorized_keys into $ROOTSSH"
    fi

    mkdir -p "$ROOTHOME/.ssh"
    if mount --bind "$ROOTSSH" "$ROOTHOME/.ssh" 2>/dev/null; then
        echo "S02identity: $ROOTSSH bound over $ROOTHOME/.ssh"
    elif [ -s "$ROOTSSH/authorized_keys" ]; then
        # Degrade to the old behaviour rather than to no key login at all.
        # A copy that needs `slot identity save` beats a board you cannot
        # reach with a key.
        cp "$ROOTSSH/authorized_keys" "$ROOTHOME/.ssh/authorized_keys"
        chmod 600 "$ROOTHOME/.ssh/authorized_keys"
        echo "S02identity: bind failed, authorized_keys copied instead"
    fi

    # Before S50sshd, so sshd finds the board's own keys and does not generate
    # a fresh set that makes this slot look like a different machine.
    if copy_host_keys "$SYSDIR/ssh" "$SSHDIR"; then
        echo "S02identity: ssh host keys restored"
    fi
}

# Capture the running system's identity back to /data. Called by
# `slot identity save` after changing a password or adding a key, rather than on
# shutdown: a write-back that only happens at shutdown is lost to the power cut
# that this board's normal way of ending is.
save() {
    data_mounted || { echo "S02identity: /data is not mounted, nothing saved"; return 1; }
    mkdir -p "$SYSDIR"
    [ -f "$ETCDIR/shadow" ] && { cp "$ETCDIR/shadow" "$SYSDIR/shadow"; chmod 600 "$SYSDIR/shadow"; }
    [ -f "$ETCDIR/passwd" ] && cp "$ETCDIR/passwd" "$SYSDIR/passwd"
    # Only meaningful on the fallback path. When the bind is live this is a
    # copy of a file onto itself, which cp declines, and that is fine.
    if ! grep -q " $ROOTHOME/.ssh " /proc/mounts 2>/dev/null; then
        mkdir -p "$ROOTSSH"
        [ -f "$ROOTHOME/.ssh/authorized_keys" ] && {
            cp "$ROOTHOME/.ssh/authorized_keys" "$ROOTSSH/authorized_keys"
            chmod 600 "$ROOTSSH/authorized_keys" 2>/dev/null
        }
    fi
    copy_host_keys "$SSHDIR" "$SYSDIR/ssh"
    sync
    echo "S02identity: identity saved to $SYSDIR"
}

stop() {
    grep -q " $ROOTHOME/.ssh " /proc/mounts 2>/dev/null && umount "$ROOTHOME/.ssh"
    grep -q " $TARGET " /proc/mounts 2>/dev/null && umount "$TARGET"
    return 0
}

case "$1" in
    start) start ;;
    save)  save ;;
    stop)  stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|save|stop|restart}"; exit 1 ;;
esac
