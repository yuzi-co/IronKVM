#!/bin/sh
#
# Install a NanoKVM-Server build and put the old one back if it does not serve.
# Runs ON the device. Stage the candidate on /data, never /tmp:
#
#   scp server/NanoKVM-Server root@<device>:/data/NanoKVM-Server.new
#   scp tools/deploy/deploy-server root@<device>:/data/
#   ssh root@<device> 'sh /data/deploy-server /data/NanoKVM-Server.new'
#
# /tmp is a 79MB tmpfs. Staging a 23MB binary there, beside the copy of
# /kvmapp/server that S95nanokvm used to make, is how a deploy got truncated in
# the first place, and cp reported the error to a caller that was not checking.
# /data is 21GB of exFAT.
#
# Why this exists: nothing supervises NanoKVM-Server. S95nanokvm starts it with
# `&` and inittab respawns only two gettys, so a build that crashes on startup
# leaves the KVM unreachable over HTTP until a person intervenes. A backup file
# and a manual copy are not a safety net - they only work when someone is
# watching. This board is out-of-band management hardware, so its availability
# outranks whatever the deploy was for.
#
# It detaches. A dropped ssh session must not abandon a deploy between removing
# the old binary and proving the new one.
#
# Environment:
#   DEPLOY_TIMEOUT   seconds to wait for HTTP 200      (default 45)
#   DEPLOY_URL       what to probe                     (default: read from
#                                                     /etc/kvm/server.yaml)
#   DEPLOY_DIR       where backups live                (default /data/deploy)

# --- probe url ---
# default_probe_url builds the loopback URL to probe from the server's own
# configuration.
#
# The guard waits for HTTP 200 and restores the previous binary when it does not
# arrive. A probe fixed at http:// therefore stops being a health check the
# moment the operator sets `proto: https`: the server answers 307 on plain HTTP,
# the guard reads that as a server that will not serve, and it puts the old
# binary back over a new one that was working. That is the guard causing the
# outage it exists to prevent, and it happened on 2026-08-19, on the first
# deploy after the protocol was switched.
#
# The port is read from the block belonging to the scheme in use. Reading the
# other one aims the probe at a socket nothing is listening to, which fails the
# same way for a different reason.
#
# An unreadable config falls back to plain HTTP on 80, which is what this script
# always assumed and what the compiled-in default serves.
default_probe_url() {
    conf=${SERVER_CONFIG:-/etc/kvm/server.yaml}

    proto=http
    port=

    if [ -r "$conf" ]
    then
        got=$(sed -n 's/^proto:[[:space:]]*\([A-Za-z][A-Za-z]*\).*/\1/p' "$conf" | head -1)
        case "$got" in
            https) proto=https ;;
            http)  proto=http ;;
        esac

        # Scoped to the block under `port:`. cert:, jwt: and logger: all carry
        # indented keys of their own, and an unscoped match would take whichever
        # came first.
        port=$(sed -n '/^port:/,/^[^[:space:]#]/p' "$conf" \
            | sed -n "s/^[[:space:]][[:space:]]*$proto:[[:space:]]*\([0-9][0-9]*\).*/\1/p" \
            | head -1)
    fi

    # A default port is left out, so the common case reads the way an operator
    # would write it by hand.
    case "$proto:$port" in
        https:|https:443) echo "https://127.0.0.1/" ;;
        http:|http:80)    echo "http://127.0.0.1/" ;;
        *)                echo "$proto://127.0.0.1:$port/" ;;
    esac
}
# --- end probe url ---

NEW=$1
DEPLOY_TIMEOUT=${DEPLOY_TIMEOUT:-45}
DEPLOY_URL=${DEPLOY_URL:-$(default_probe_url)}
DEPLOY_DIR=${DEPLOY_DIR:-/data/deploy}
CURRENT=${CURRENT:-/kvmapp/server/NanoKVM-Server}
GOOD=${GOOD:-$DEPLOY_DIR/known-good/NanoKVM-Server}
LOG=${DEPLOY_LOG:-$DEPLOY_DIR/deploy.log}

say() {
    echo "$*"
    [ -d "$(dirname "$LOG")" ] && echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"
}

# --- running ---
# running_matches_installed reports whether a server process that is running now
# was started from the file just installed.
#
# It used to hash /tmp/server/NanoKVM-Server against CURRENT, because S95nanokvm
# ran a copy from there. /tmp/server is now a link to /kvmapp/server, so that
# compares a file with itself and passes while the old process still answers.
#
# The process is the evidence instead. install_file renames the new file over
# CURRENT, and the kernel then prints every mapping of the replaced file with
# " (deleted)" after its path: measured on the device on 2026-09-17. A process
# that maps CURRENT under its plain path therefore started after the install.
# That holds for a library as much as for the binary, so CURRENT may name
# libkvm.so.
#
# The kernel prints the resolved path, so CURRENT is resolved too, and a CURRENT
# given through the /tmp/server link still matches.
PROC=${PROC:-/proc}

running_matches_installed() {
    installed=$(readlink -f "$CURRENT" 2>/dev/null) || installed=$CURRENT
    [ -n "$installed" ] || installed=$CURRENT

    for pid in $(pidof NanoKVM-Server 2>/dev/null); do
        awk '{ $1 = $2 = $3 = $4 = $5 = ""; sub(/^ +/, ""); print }' "$PROC/$pid/maps" 2>/dev/null \
            | grep -qxF -e "$installed" && return 0
    done
    return 1
}
# --- end running ---

# --- install ---
# install_file puts a file in place by renaming it there, never by writing over it.
#
# The server runs from /kvmapp/server now, not from a copy in tmpfs, so the file
# this replaces can be mapped by the running process. cp over it goes wrong both
# ways: over the executable it fails with ETXTBSY and the deploy installs
# nothing, and over a loaded library it truncates pages the server is executing,
# which kills it with SIGBUS. A rename leaves the running process its own file
# and gives the next one the new file.
#
# The temporary name sits beside the target, so the rename stays on one
# filesystem and is atomic. It is compared with the source before the rename,
# because a short copy is the failure this script was written after.
install_file() {   # $1 = source, $2 = destination
    tmp="$2.deploy-new"
    rm -f "$tmp"

    if cp "$1" "$tmp" && chmod 755 "$tmp" && cmp -s "$1" "$tmp" && mv -f "$tmp" "$2"; then
        return 0
    fi

    rm -f "$tmp"
    return 1
}
# --- end install ---

candidate_is_elf() {
    [ "$(head -c 4 "$NEW" | od -An -tx1 | tr -d ' 
')" = "7f454c46" ]
}

candidate_size_kb() {
    echo $(( $(wc -c < "$NEW") / 1024 ))
}

# install_free_kb is the free space where CURRENT lives. install_file holds the
# new file beside the old one until the rename, so both must fit at once.
install_free_kb() {
    df -k "$(dirname "$CURRENT")" | awk 'NR==2{print $4}'
}

# serving reports whether the server answers. A 401 counts: the process is up,
# has bound its port and read its config, which is what is being tested here.
serving() {
    code=$(curl -sSk -o /dev/null -w '%{http_code}' --max-time 5 "$DEPLOY_URL" 2>/dev/null)
    case "$code" in
        2??|3??|401) return 0 ;;
    esac
    return 1
}

# --- settle ---
# settled_within waits for the restart to actually land.
#
# Waiting for "something answers" is not enough and was the bug that made this
# block necessary. `restart` is detached, so for a second or two after it the
# process still answering is the old one - and the verdict taken at that moment
# reads "it serves, but that is not what I installed", which is the exact
# signature of a corrupt candidate. On a device the guard stamped `installed,
# restarting` and `FAILED to serve` in the same second and rolled back a build
# that was fine.
#
# So it waits for both conditions together, and keeps asking until the deadline
# rather than judging once.
settled_within() {
    limit=$1
    waited=0

    while [ "$waited" -lt "$limit" ]; do
        if serving && running_matches_installed; then
            return 0
        fi
        waited=$((waited + 1))
        sleep 1
    done

    return 1
}
# --- end settle ---

# --- standoff ---
# Tell S98supervise to leave the board alone while this runs.
#
# The supervisor polls every five seconds and acts on a server it finds gone or
# not answering. A deploy stops the server, replaces the binary and restarts it,
# which looks like exactly that from outside. On 2026-08-17 the supervisor
# started the server in the middle of a deploy and then killed it 63 seconds
# later as hung, while this script was still deciding whether its own candidate
# worked. Two things restarting the same service is how a verdict becomes
# meaningless.
#
# The path is the same one the updater writes. If these two ever disagree the
# stand-off protects nothing, so the test compares them.
#
# Unlike the updater, this script is not the thing being replaced, so it can
# clean up after itself and must: a marker left behind suspends the supervisor
# for the whole stand-off window, and a supervisor that never acts is worse than
# one that acts too early.
UPDATE_MARKER=${UPDATE_MARKER:-/tmp/nanokvm-updating}

# The marker carries the time it was written, in its contents, because the
# reader cannot get it from the filesystem: busybox on this device is built
# without FEATURE_STAT_FORMAT, so `stat -c %Y` does not exist there.
hold_supervisor() {
    date +%s > "${UPDATE_MARKER:-/tmp/nanokvm-updating}" 2>/dev/null || true
}

release_supervisor() {
    rm -f "${UPDATE_MARKER:-/tmp/nanokvm-updating}" 2>/dev/null || true
}
# --- end standoff ---

restart() {
    # S95nanokvm backgrounds the server with `&`, so it inherits this shell's
    # stdio and would hold the ssh session open. setsid detaches it properly;
    # tools/build/README.md records the same trap.
    setsid sh -c '/etc/init.d/S95nanokvm restart > /tmp/deploy-restart.log 2>&1' \
        < /dev/null > /dev/null 2>&1 &
}

# --- verdict ---
# Serving is necessary and not sufficient.
#
# An HTTP 200 can come from a process that is not running the file just
# installed. That is not hypothetical: when S95nanokvm ran a copy from tmpfs,
# tmpfs filled up during a deploy, the candidate landed truncated, and an earlier
# version of this script reported OK - leaving a board that would have failed to
# start on its next reboot. The same holds for an old process that has not been
# replaced yet.
#
# A deploy is only good if the service answers AND what is running is what was
# installed.
verdict() {
    if ! serving; then
        echo restore
        return
    fi

    if ! running_matches_installed; then
        echo restore
        return
    fi

    echo keep
}

# restore_worked reports whether the box came back after a rollback. A restore
# that does not serve is the state this script exists to prevent, so the caller
# has to be able to say so loudly instead of exiting 0.
restore_worked() {
    serving
}
# --- end verdict ---

# --- preflight ---
# Refuse before touching anything.
#
# The candidate must be intact. A short or empty file is the failure that started
# all this, and a truncated Go binary can still start, so size alone is a weak
# test - check that it is an ELF as well.
#
# The filesystem that holds CURRENT must also have room, because install_file
# keeps the new file beside the old one until it renames. That needs one
# candidate's size. Half as much again is margin, so a filesystem that is
# nearly full is refused before anything is written to it.
preflight() {
    if ! candidate_is_elf; then
        return 1
    fi

    needed=$(candidate_size_kb)
    free=$(install_free_kb)

    [ "$free" -ge $((needed + needed / 2)) ]
}
# --- end preflight ---

# --- snapshot ---
# Keep a copy of the last binary that was proven to serve.
#
# Snapshot only while the server that is running right now answers. Deploy twice
# in a row without this test and the second snapshot would preserve the first
# broken binary as the thing to fall back to, which is worse than having no
# snapshot at all.
snapshot_if_proven() {
    if ! serving; then
        return 1
    fi

    mkdir -p "$(dirname "$GOOD")"
    cp "$CURRENT" "$GOOD"

    return 0
}
# --- end snapshot ---

main() {
    [ -n "$NEW" ] || { echo "usage: deploy-server <new-binary>"; exit 1; }
    [ -f "$NEW" ] || { echo "no such file: $NEW"; exit 1; }

    mkdir -p "$DEPLOY_DIR/known-good"

    # Stand the supervisor off for the whole run. The trap covers every exit
    # path there is - the five verdicts below, a failed preflight, and a shell
    # that dies for a reason none of them anticipated.
    trap release_supervisor EXIT
    hold_supervisor

    say "deploy: starting, candidate $(wc -c < "$NEW") bytes"

    if ! preflight; then
        say "deploy: REFUSED - candidate is not an intact ELF, or $(dirname "$CURRENT") has only $(install_free_kb)kB free for a $(candidate_size_kb)kB binary"
        say "deploy: nothing was changed"
        exit 4
    fi

    if snapshot_if_proven; then
        say "deploy: snapshotted the running server as known-good ($(wc -c < "$GOOD") bytes)"
    else
        if [ -f "$GOOD" ]; then
            say "deploy: server is not answering, keeping the existing known-good"
        else
            say "deploy: server is not answering and nothing is saved - no rollback available"
        fi
    fi

    if ! install_file "$NEW" "$CURRENT"; then
        say "deploy: REFUSED - could not install $NEW as $CURRENT"
        say "deploy: nothing was changed"
        exit 4
    fi
    say "deploy: installed, restarting"
    restart

    if settled_within "$DEPLOY_TIMEOUT"; then
        say "deploy: OK, serving within ${DEPLOY_TIMEOUT}s and running what was installed"
        exit 0
    fi

    if serving; then
        say "deploy: FAILED - it serves, but no running server maps the $CURRENT just installed"
    else
        say "deploy: FAILED to serve within ${DEPLOY_TIMEOUT}s"
    fi

    if [ ! -f "$GOOD" ]; then
        say "deploy: no known-good binary to restore - the board needs attention"
        exit 2
    fi

    say "deploy: restoring the known-good binary"
    if ! install_file "$GOOD" "$CURRENT"; then
        say "deploy: could not put $GOOD back as $CURRENT - the board needs attention"
        exit 3
    fi
    restart

    # The same wait, for the same reason: for a moment after the restore the
    # process still answering is the one that was just removed.
    if settled_within "$DEPLOY_TIMEOUT" && restore_worked; then
        say "deploy: rolled back, serving again"
        exit 1
    fi

    say "deploy: ROLLBACK ALSO FAILED - the board needs attention"
    exit 3
}

# Detach, so that losing the ssh session cannot abandon the deploy between
# replacing the binary and proving it.
if [ "$DEPLOY_ATTACHED" = "1" ]; then
    main
else
    mkdir -p "$DEPLOY_DIR"
    DEPLOY_ATTACHED=1 setsid sh "$0" "$NEW" > "$DEPLOY_DIR/last-run.log" 2>&1 &
    echo "deploy: running detached, watch $DEPLOY_DIR/last-run.log"
    echo "deploy: it will restore the previous binary if the new one does not serve"
fi
