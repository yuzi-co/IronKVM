Dockerfile
# The pnpm store is gitignored but was not excluded here, so the whole
# store was sent as build context. On Windows that fails outright: the
# sender hits a file it cannot open and the build ends before the first
# layer runs. web/ is already excluded wholesale, which covers
# web/node_modules.
.pnpm-store
# Opus build output. The libtool .la file under .libs is a symlink that
# buildkit refuses to send, so this directory stops the build the same way.
tools/opusbench/.build
!server/go.mod
server/go.sum
server/NanoKVM-Server
web

support/sg2002/kvm_system/build
support/sg2002/kvm_system/dist
support/sg2002/kvm_system/CMakeLists.txt

support/sg2002/kvm_vision_test/build
support/sg2002/kvm_vision_test/dist
support/sg2002/kvm_vision_test/CMakeLists.txt
# Build output and caches. None of it is a source the builder image needs, and
# all of it is large: .pnpm-store is 254MB, release-out holds two card images at
# 372MB each, and base/ is the 268MB pinned Sipeed input that only release.sh
# reads, on the host, from the bind mount.
#
# .pnpm-store is not optional. pnpm keeps a content-addressable store here when
# the home directory is on another filesystem, and one of its files cannot be
# opened by a Windows process, so loading the context fails outright:
#   error from sender: open .pnpm-store\v11\projects\...: The file cannot be
#   accessed by the system
.git
.pnpm-store
release-out
base

# tools/opusbench/.build holds a libtool tree made under Linux. It contains
# .libs/libopus.la as a relative symlink, and the context sender on a Windows
# workstation refuses it:
#   invalid file request tools/opusbench/.build/build/.libs/libopus.la
tools/opusbench/.build

# official-kvmapp is unpacked by release.sh on every run, on the host.
official-kvmapp

# Agent scratch space, and the two build trees the makefile writes in place.
.superpowers
kvmapp/server
